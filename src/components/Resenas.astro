---
// Carrusel de reseñas de la home. Los datos están en src/lib/resenas.js.
import TarjetaResena from './TarjetaResena.astro'
import { RESENAS, NOTA, TOTAL, URL_VALORAR } from '../lib/resenas.js'
---

<section class='rs'>
  <div class='rs-header'>
    <span class='tag' style='color:var(--red);'>Opiniones reales</span>
    <h2 class='s-title'>Lo que dicen nuestros clientes</h2>
    <div class='rs-resumen'>
      <div class='rs-nota'>
        {NOTA.toLocaleString('es-ES', { minimumFractionDigits: 1 })}
      </div>
      <div>
        <div class='rs-estrellas-top' aria-hidden='true'>★★★★★</div>
        <div class='rs-total'>{TOTAL} reseñas en Google</div>
      </div>
    </div>
  </div>

  <div class='rs-carrusel'>
    <button type='button' class='rs-flecha rs-prev' aria-label='Reseñas anteriores'
      >‹</button
    >
    <div class='rs-pista' tabindex='0' role='region' aria-label='Reseñas de clientes'>
      {RESENAS.map((r, i) => <TarjetaResena r={r} i={i} corta />)}
    </div>
    <button type='button' class='rs-flecha rs-next' aria-label='Más reseñas'
      >›</button
    >
  </div>

  <div class='rs-cta'>
    <a href={URL_VALORAR} class='hero-btn-main' target='_blank' rel='noopener'
      >★ Valóranos en Google</a
    >
    <a href='/opiniones/' class='rs-todas'>Ver todas las opiniones →</a>
  </div>
</section>

<style>
  .rs {
    max-width: 1100px;
    margin: 0 auto;
  }
  .rs-header {
    margin-bottom: 2.2rem;
    text-align: center;
  }
  .rs-resumen {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1rem;
    padding: 1rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--gray);
  }
  .rs-nota {
    font-family: var(--font-h);
    font-size: 2.6rem;
    font-weight: 800;
    line-height: 1;
    color: var(--text);
  }
  .rs-estrellas-top {
    font-size: 1.05rem;
    letter-spacing: 2px;
    color: #fbbf24;
  }
  .rs-total {
    margin-top: 0.2rem;
    font-size: 0.82rem;
    color: var(--muted);
  }

  /* Carrusel: se desliza con el dedo; en ordenador, también con las flechas */
  .rs-carrusel {
    position: relative;
  }
  .rs-pista {
    display: flex;
    gap: 1.2rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding: 0 0.2rem;
    padding: 0.2rem 0.2rem 1rem;
    scrollbar-width: thin;
  }
  .rs-pista :global(.rs-card) {
    flex: 0 0 min(320px, 82vw);
    scroll-snap-align: start;
  }
  .rs-flecha {
    position: absolute;
    top: 45%;
    z-index: 2;
    width: 42px;
    height: 42px;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: #fff;
    box-shadow: var(--shadow);
    font-size: 1.5rem;
    line-height: 1;
    color: var(--text);
    cursor: pointer;
    transform: translateY(-50%);
  }
  .rs-prev {
    left: -16px;
  }
  .rs-next {
    right: -16px;
  }
  .rs-flecha:hover {
    border-color: var(--red);
    color: var(--red);
  }
  @media (hover: none), (max-width: 760px) {
    .rs-flecha {
      display: none;
    }
  }

  .rs-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem 1.6rem;
    margin-top: 1.6rem;
  }
  .rs-todas {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--red);
  }
</style>

<script>
  // Flechas: avanzan una tarjeta
  document.querySelectorAll('.rs-carrusel').forEach((c) => {
    const pista = c.querySelector<HTMLElement>('.rs-pista')!
    const mover = (dir: number) => {
      const tarjeta = pista.querySelector<HTMLElement>('.rs-card')
      const paso = (tarjeta?.offsetWidth ?? 320) + 19
      pista.scrollBy({ left: dir * paso, behavior: 'smooth' })
    }
    c.querySelector('.rs-prev')?.addEventListener('click', () => mover(-1))
    c.querySelector('.rs-next')?.addEventListener('click', () => mover(1))
  })
</script>
