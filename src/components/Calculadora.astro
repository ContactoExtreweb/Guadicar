---
const { precio = 20000 } = Astro.props;
const plazos = [120, 108, 96, 84, 72, 60, 48, 36, 24, 12, 6];
---
<div class="calc" data-precio={precio}>
  <button class="calc-toggle" type="button">
    <svg width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/><line x1="8" y1="10" x2="16" y2="10"/><line x1="8" y1="14" x2="12" y2="14"/></svg>
    Calcular cuota
  </button>

  <div class="calc-panel" hidden>
    <div class="calc-field">
      <label>Entrada inicial</label>
      <div class="calc-input-wrap">
        <input type="number" class="calc-entrada" min="0" max={precio} step="100" value="0" placeholder="0" />
        <span>€</span>
      </div>
    </div>

    <div class="calc-field">
      <label>Plazo (meses)</label>
      <div class="calc-plazos">
        {plazos.map((m) => (
          <button type="button" class={`calc-plazo${m === 96 ? ' active' : ''}`} data-meses={m}>{m}</button>
        ))}
      </div>
    </div>

    <div class="calc-result">
      <div class="calc-cuota"><span class="calc-cuota-num">—</span><span class="calc-cuota-mes">/mes</span></div>
      <div class="calc-detalle">
        <span>A financiar: <strong class="calc-capital">—</strong></span>
        <span>TAE <strong>7,99%</strong></span>
      </div>
    </div>
    <p class="calc-aviso">Cálculo orientativo. No constituye una oferta vinculante. Sujeto a aprobación de la entidad financiera.</p>
  </div>
</div>

<style>
  .calc { margin:1.3rem 0; }
  .calc-toggle { width:100%; display:flex; align-items:center; justify-content:center; gap:.5rem;
    background:var(--gray); border:1px solid var(--border); border-radius:12px; padding:.9rem;
    font-family:inherit; font-size:.9rem; font-weight:700; color:var(--text); cursor:pointer; transition:.2s; }
  .calc-toggle:hover { border-color:var(--red); color:var(--red); }
  .calc-panel { background:var(--gray); border:1px solid var(--border); border-radius:14px; padding:1.4rem; margin-top:.7rem; }
  .calc-field { margin-bottom:1.3rem; }
  .calc-field label { display:block; font-size:.82rem; font-weight:700; margin-bottom:.55rem; }
  .calc-input-wrap { display:flex; align-items:center; background:#fff; border:1px solid var(--border); border-radius:10px; overflow:hidden; }
  .calc-input-wrap input { flex:1; border:none; outline:none; padding:.75rem .9rem; font-family:inherit; font-size:1.1rem; font-weight:700; text-align:right; color:var(--text); }
  .calc-input-wrap span { padding:0 1rem; font-weight:700; color:var(--muted); }
  .calc-plazos { display:grid; grid-template-columns:repeat(4, 1fr); gap:.5rem; }
  .calc-plazo { padding:.6rem 0; border:1px solid var(--border); background:#fff; border-radius:9px; font-family:inherit; font-size:.9rem; font-weight:700; color:var(--text); cursor:pointer; transition:.15s; }
  .calc-plazo:hover { border-color:var(--red); }
  .calc-plazo.active { background:var(--red); color:#fff; border-color:var(--red); }
  .calc-result { background:var(--black); border-radius:12px; padding:1.2rem; text-align:center; }
  .calc-cuota-num { font-family:var(--font-h); font-size:2.4rem; font-weight:800; color:#fff; }
  .calc-cuota-mes { color:rgba(255,255,255,.6); font-weight:600; }
  .calc-detalle { display:flex; justify-content:space-between; margin-top:.6rem; font-size:.78rem; color:rgba(255,255,255,.7); }
  .calc-detalle strong { color:#fff; }
  .calc-aviso { font-size:.7rem; color:var(--muted); margin-top:.8rem; line-height:1.5; text-align:center; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.calc').forEach(calc => {
    const precio = Number(calc.dataset.precio);
    const TAE = 7.99;
    const $ = (s: string) => calc.querySelector(s) as HTMLElement;
    const toggle = $('.calc-toggle'), panel = $('.calc-panel');
    const entrada = $('.calc-entrada') as HTMLInputElement;
    let meses = 96;

    const fmt = (n: number) => Math.round(n).toLocaleString('es-ES');

    const recalc = () => {
      let ent = Number(entrada.value) || 0;
      if (ent > precio) { ent = precio; entrada.value = String(precio); }
      const capital = Math.max(precio - ent, 0);
      const r = TAE / 100 / 12;
      const cuota = capital === 0 ? 0 : capital * r / (1 - Math.pow(1 + r, -meses));
      $('.calc-capital').textContent = fmt(capital) + ' €';
      $('.calc-cuota-num').textContent = fmt(cuota) + ' €';
    };

    toggle.addEventListener('click', () => { panel.hidden = !panel.hidden; recalc(); });
    entrada.addEventListener('input', recalc);
    calc.querySelectorAll<HTMLElement>('.calc-plazo').forEach(btn => {
      btn.addEventListener('click', () => {
        meses = Number(btn.dataset.meses);
        calc.querySelectorAll('.calc-plazo').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        recalc();
      });
    });
  });
</script>