---
import Base from '../layouts/Base.astro'
import Newsletter from '../components/Newsletter.astro'
import Resenas from '../components/Resenas.astro'
import {
  getDestacados,
  getOcasionSemana,
  getVehiculos,
  fmt,
  badgeDe,
} from '../lib/coches.js'

export const prerender = false // para mostrar los coches reales y que se actualice al añadirlos

const destacados = await getDestacados() // coches marcados como "destacado" en el panel
const ocasion = await getOcasionSemana() // coche marcado como "ocasión de la semana"
const publicados = (await getVehiculos())
  .filter((c) => !c.destacado)
  .slice(0, 4) // mostramos 4 coches publicados sin marcar.
---

<Base
  heroNav={false}
  title='GuadiCar Multimarcas — Coches de Ocasión y Km0 en Villanueva de la Serena (Badajoz)'
>
  <section class='home-intro'>
    <div class='intro-grid'>
      <div class='intro-text'>
        <span class='intro-eyebrow'
          >● Concesionario multimarca · Villanueva de la Serena</span
        >
        <h1>Tu próximo coche está en <em>GuadiCar</em></h1>
        <p class='intro-lead'>
          Más de 35 años ayudando a nuestros vecinos a encontrar el coche que
          necesitan. Vehículos de ocasión y Km0 revisados uno a uno, sin letra
          pequeña y con atención personal de principio a fin.
        </p>
      </div>

      <div class='intro-media'>
        <div class='intro-foto'>
          <img
            src='/guadicar-instalaciones.jpg'
            alt='Instalaciones de GuadiCar Multimarcas'
            onerror="this.style.display='none';this.parentElement.classList.add('sin-foto')"
          />
          <div class='intro-foto-ph'>🚗</div>
          <div class='intro-logo-chip'>
            <img src='/logo.png' alt='GuadiCar Multimarcas' />
          </div>
          <div class='intro-foto-badge'>
            <strong>GuadiCar Multimarcas</strong>
            <span>Polígono Cagancha · Villanueva de la Serena</span>
          </div>
        </div>
      </div>

      <div class='intro-ctas'>
        <a href='/vehiculos' class='hero-btn-main'
          >Ver coches disponibles
          <svg
            width='17'
            height='17'
            fill='none'
            stroke='currentColor'
            stroke-width='2.5'
            viewBox='0 0 24 24'><path d='M5 12h14M12 5l7 7-7 7'></path></svg
          >
        </a>
        <a href='tel:+34722496124' class='intro-btn-tel'>
          <svg
            width='18'
            height='18'
            fill='none'
            stroke='currentColor'
            stroke-width='2'
            viewBox='0 0 24 24'
            ><path
              d='M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z'
            ></path></svg
          >
          <span><small>Contacta al</small><strong>722 49 61 24</strong></span>
        </a>
      </div>
    </div>

    <div class='intro-confianza'>
      <div class='ic-item'>
        <strong>+35</strong><span>años en el sector</span>
      </div>
      <div class='ic-item'>
        <strong>1 año</strong><span>de garantía mínima</span>
      </div>
      <div class='ic-item'>
        <strong>100%</strong><span>coches certificados y revisados</span>
      </div>
      <div class='ic-item'>
        <strong>Atención</strong><span>personalizada de principio a fin</span>
      </div>
    </div>
  </section>

  {
    ocasion && (
      <section class='section section--white'>
        <div
          class='s-header'
          style='text-align:center;max-width:580px;margin:0 auto 2.5rem;'
        >
          <span class='tag'>Oferta destacada</span>
          <h2 class='s-title'>Ocasión de la semana</h2>
        </div>
        <div class='ocasion-card reveal'>
          <div class='ocasion-img'>
            <img
              src={ocasion.fotos?.[0] || '/placeholder-coche.jpg'}
              alt={`${ocasion.marca} ${ocasion.modelo}`}
            />
            {ocasion.certificado && (
              <div class='car-cert'>✓ Revisado y certificado</div>
            )}
            {ocasion.reservado && <div class='car-reservado'>Reservado</div>}
          </div>
          <div class='ocasion-body'>
            <div class='ocasion-flag'>★ Ocasión de la semana</div>
            <div class='car-brand'>{ocasion.marca}</div>
            <div class='ocasion-model'>{ocasion.modelo}</div>
            <div class='car-tags'>
              <span class='car-tag'>{ocasion.anio}</span>
              <span class='car-tag'>{fmt(ocasion.km)} km</span>
              <span class='car-tag'>{ocasion.combustible}</span>
              <span class='car-tag'>{ocasion.cambio}</span>
            </div>
            <div class='price-box price-box--lg'>
              <div class='price-main'>
                <>
                  <span class='price-num'>{fmt(ocasion.precio)}</span>
                  <span class='price-cur'>€</span>
                </>
              </div>
              <div class='price-fin'>
                Financiación desde <strong>{ocasion.cuota}€/mes</strong>
              </div>
            </div>
            <a
              href={`/vehiculos/${ocasion.slug}`}
              class='hero-btn-main'
              style='align-self:flex-start;'
            >
              Ver ficha completa
            </a>
          </div>
        </div>
      </section>
    )
  }

  {
    destacados.length > 0 && (
      <section class='section section--gray'>
        <div class='s-header--row'>
          <div>
            <>
              <span class='tag'>Stock destacado</span>
              <h2 class='s-title'>Vehículos destacados</h2>
            </>
          </div>
          <a
            href='/vehiculos'
            style='font-size:0.82rem;font-weight:700;color:var(--red);display:flex;align-items:center;gap:0.3rem;'
          >
            Ver todo el catálogo →
          </a>
        </div>
        <div class='cars-grid'>
          {destacados.map((c) => (
            <a href={`/vehiculos/${c.slug}`} class='car-card reveal'>
              <div class='car-img'>
                <img
                  src={c.fotos?.[0] || '/placeholder-coche.jpg'}
                  alt={`${c.marca} ${c.modelo}`}
                />
                <div class='car-img-overlay' />
                {badgeDe(c) && <div class='car-badge'>{badgeDe(c)}</div>}
                {c.certificado && <div class='car-cinta'>Certificado</div>}
                {c.reservado && <div class='car-reservado'>Reservado</div>}
              </div>
              <div class='car-body'>
                <div class='car-brand'>{c.marca}</div>
                <div class='car-name'>{c.modelo}</div>
                <div class='car-tags'>
                  <span class='car-tag'>{c.anio}</span>
                  <span class='car-tag'>{fmt(c.km)} km</span>
                  <span class='car-tag'>{c.combustible}</span>
                </div>
                <div class='car-price-row'>
                  <div class='car-price-main'>
                    <span class='car-price'>
                      {fmt(c.precio)}
                      <span style='font-size:1rem;'>€</span>
                    </span>
                    {c.precioAnterior && (
                      <span class='car-price-old'>
                        {fmt(c.precioAnterior)}€
                      </span>
                    )}
                  </div>
                  <div class='car-price-fin'>
                    Desde <strong>{c.cuota}€/mes</strong>
                  </div>
                </div>
                <span class='btn-card'>Ver ficha</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )
  }
  {
    publicados.length > 0 && (
      <section class='section section--white'>
        <div class='s-header--row'>
          <div>
            <>
              <span class='tag'>Recién llegados</span>
              <h2 class='s-title'>Últimas incorporaciones</h2>
            </>
          </div>
          <a
            href='/vehiculos'
            style='font-size:0.82rem;font-weight:700;color:var(--red);display:flex;align-items:center;gap:0.3rem;'
          >
            Ver todos los coches →
          </a>
        </div>
        <div class='cars-grid'>
          {publicados.map((c) => (
            <a href={`/vehiculos/${c.slug}`} class='car-card reveal'>
              <div class='car-img'>
                <img
                  src={c.fotos?.[0] || '/placeholder-coche.jpg'}
                  alt={`${c.marca} ${c.modelo}`}
                />
                <div class='car-img-overlay' />
                {badgeDe(c) && <div class='car-badge'>{badgeDe(c)}</div>}
                {c.certificado && <div class='car-cinta'>Certificado</div>}
                {c.reservado && <div class='car-reservado'>Reservado</div>}
              </div>
              <div class='car-body'>
                <div class='car-brand'>{c.marca}</div>
                <div class='car-name'>{c.modelo}</div>
                <div class='car-tags'>
                  <span class='car-tag'>{c.anio}</span>
                  <span class='car-tag'>{fmt(c.km)} km</span>
                  <span class='car-tag'>{c.combustible}</span>
                </div>
                <div class='car-price-row'>
                  <div class='car-price-main'>
                    <span class='car-price'>
                      {fmt(c.precio)}
                      <span style='font-size:1rem;'>€</span>
                    </span>
                    {c.precioAnterior && (
                      <span class='car-price-old'>
                        {fmt(c.precioAnterior)}€
                      </span>
                    )}
                  </div>
                  <div class='car-price-fin'>
                    Desde <strong>{c.cuota}€/mes</strong>
                  </div>
                </div>
                <span class='btn-card'>Ver ficha</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )
  }
  <section class='section section--white'>
    <Resenas />
  </section>
  <section class='section section--dark video-section'>
    <div class='video-inner'>
      <div class='video-text'>
        <span class='tag' style='color:var(--red);'>Conócenos</span>
        <h2 class='video-title'>Visita nuestras instalaciones</h2>
        <p class='video-desc'>
          Más de tres décadas ayudando a nuestros clientes a moverse con un
          coche de confianza. Cada vehículo de nuestras instalaciones está
          revisado y certificado punto por punto. Te invitamos a visitarnos sin
          compromiso.
        </p>
      </div>
      <div class='video-wrap reveal'>
        <video controls>
          <source src='/instalaciones_guadicar.mp4' type='video/mp4' />
        </video>
      </div>
    </div>
  </section>

  <section class='section section--gray'>
    <Newsletter variant='section' />
  </section>

  <div class='cta-strip'>
    <div>
      <h2>¿Tienes un coche que vender?</h2><p>
        Tasación gratuita en 24h · Sin compromiso · Pago inmediato
      </p>
    </div>
    <a href='/contacto' class='btn-white'>Solicitar tasación</a>
  </div>

  <style>
    @property --aura-ang {
      syntax: '<angle>';
      inherits: false;
      initial-value: 0deg;
    }

    .home-intro {
      background: linear-gradient(180deg, var(--gray) 0%, #fff 100%);
      padding: 7.5rem 1.5rem 3.5rem;
      overflow: hidden;
    }

    /* PC: texto + botones a la izquierda, imagen a la derecha */
    .intro-grid {
      max-width: 1150px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 1.05fr;
      grid-template-areas:
        'texto media'
        'botones media';
      column-gap: 3.5rem;
      row-gap: 1.6rem;
      align-items: center;
    }
    .intro-text {
      grid-area: texto;
      align-self: end;
    }
    .intro-ctas {
      grid-area: botones;
      align-self: start;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 1rem;
    }
    .intro-media {
      grid-area: media;
      position: relative;
    }

    .intro-eyebrow {
      display: inline-block;
      font-size: 0.78rem;
      font-weight: 800;
      color: var(--red);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 1rem;
    }
    .intro-text h1 {
      font-family: var(--font-h);
      font-size: clamp(2.1rem, 4vw, 3.1rem);
      font-weight: 800;
      line-height: 1.08;
      letter-spacing: -1.5px;
      margin: 0 0 1.2rem;
      color: var(--text);
    }
    .intro-text h1 em {
      font-style: normal;
      color: var(--red);
    }
    .intro-lead {
      font-size: 1.05rem;
      line-height: 1.7;
      color: var(--muted);
      margin: 0;
      max-width: 540px;
    }

    .intro-btn-tel {
      display: inline-flex;
      align-items: center;
      gap: 0.7rem;
      padding: 0.7rem 1.2rem 0.7rem 0.9rem;
      border: 1px solid var(--border);
      border-radius: 999px;
      background: #fff;
      color: var(--text);
      text-decoration: none;
      transition:
        border-color 0.15s ease,
        transform 0.15s ease,
        box-shadow 0.15s ease;
    }
    .intro-btn-tel:hover {
      border-color: var(--red);
      transform: translateY(-2px);
      box-shadow: var(--shadow);
    }
    .intro-btn-tel svg {
      color: var(--red);
      flex: 0 0 auto;
    }
    .intro-btn-tel span {
      display: flex;
      flex-direction: column;
      line-height: 1.1;
    }
    .intro-btn-tel small {
      font-size: 0.68rem;
      color: var(--muted);
      font-weight: 600;
    }
    .intro-btn-tel strong {
      font-size: 1rem;
      font-weight: 800;
      letter-spacing: 0.01em;
    }

    /* Foto + aura roja girando por detrás */
    .intro-media::before {
      content: '';
      position: absolute;
      inset: -14px;
      z-index: 0;
      border-radius: 28px;
      background: conic-gradient(
        from var(--aura-ang),
        rgba(204, 28, 28, 0) 0deg,
        rgba(204, 28, 28, 0) 200deg,
        rgba(204, 28, 28, 0.45) 290deg,
        rgba(255, 95, 95, 0.9) 325deg,
        rgba(204, 28, 28, 0.45) 360deg
      );
      filter: blur(22px);
      opacity: 0.7;
      animation: intro-aura 14s linear infinite;
    }
    .intro-foto {
      position: relative;
      z-index: 1;
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: var(--shadow-lg);
      border: 1px solid var(--border);
      aspect-ratio: 4 / 3;
      background: #f0f0f2;
    }
    .intro-foto img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .intro-foto-ph {
      display: none;
    }
    .intro-foto.sin-foto {
      display: flex;
      align-items: center;
      justify-content: center;
      background: repeating-linear-gradient(
        45deg,
        #f4f4f6,
        #f4f4f6 14px,
        #eeeef1 14px,
        #eeeef1 28px
      );
    }
    .intro-foto.sin-foto .intro-foto-ph {
      display: block;
      font-size: 3.5rem;
      opacity: 0.4;
    }
    .intro-logo-chip {
      position: absolute;
      top: 0.9rem;
      left: 0.9rem;
      z-index: 3;
      background: rgba(13, 13, 13, 0.78);
      backdrop-filter: blur(5px);
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 12px;
      padding: 0.5rem 0.8rem;
    }
    .intro-logo-chip img {
      display: block;
      height: 26px;
      width: auto;
    }
    .intro-foto-badge {
      position: absolute;
      left: 1.2rem;
      bottom: 1.2rem;
      z-index: 3;
      background: rgba(13, 13, 13, 0.82);
      backdrop-filter: blur(5px);
      color: #fff;
      padding: 0.8rem 1.1rem;
      border-radius: 12px;
      border: 1px solid rgba(255, 255, 255, 0.12);
    }
    .intro-foto-badge strong {
      display: block;
      font-size: 0.95rem;
      font-weight: 800;
    }
    .intro-foto-badge span {
      display: block;
      font-size: 0.78rem;
      opacity: 0.8;
      margin-top: 0.15rem;
    }

    /* Franja de confianza */
    .intro-confianza {
      max-width: 1150px;
      margin: 3rem auto 0;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
      padding-top: 2rem;
      border-top: 1px solid var(--border);
    }
    .ic-item {
      text-align: center;
    }
    .ic-item strong {
      display: block;
      font-family: var(--font-h);
      font-size: 1.9rem;
      font-weight: 800;
      color: var(--red);
      line-height: 1;
      letter-spacing: -1px;
    }
    .ic-item span {
      display: block;
      font-size: 0.82rem;
      color: var(--muted);
      margin-top: 0.35rem;
      font-weight: 500;
    }

    /* Animaciones de entrada (suaves y escalonadas) */
    @keyframes introUp {
      from {
        opacity: 0;
        transform: translateY(18px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
    @keyframes intro-aura {
      to {
        --aura-ang: 360deg;
      }
    }
    .intro-text,
    .intro-ctas,
    .intro-media,
    .intro-confianza {
      animation: introUp 0.7s cubic-bezier(0.2, 0.7, 0.3, 1) backwards;
    }
    .intro-media {
      animation-delay: 0.12s;
    }
    .intro-ctas {
      animation-delay: 0.24s;
    }
    .intro-confianza {
      animation-delay: 0.3s;
    }

    @media (prefers-reduced-motion: reduce) {
      .intro-media::before,
      .intro-text,
      .intro-ctas,
      .intro-media,
      .intro-confianza {
        animation: none;
      }
    }

    /* MÓVIL: texto → imagen → botones */
    @media (max-width: 860px) {
      .home-intro {
        padding: 6.5rem 1.2rem 2.5rem;
      }
      .intro-grid {
        display: flex;
        flex-direction: column;
        gap: 1.6rem;
      }
      .intro-text {
        order: 1;
        text-align: center;
      }
      .intro-media {
        order: 2;
      }
      .intro-ctas {
        order: 3;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        width: 100%;
        gap: 0.8rem;
        margin-top: 0.4rem;
      }
      .intro-ctas .hero-btn-main,
      .intro-ctas .intro-btn-tel {
        width: 100%;
        justify-content: center;
        text-align: center;
      }
      .intro-eyebrow {
        display: inline-flex;
      }
      .intro-lead {
        margin-left: auto;
        margin-right: auto;
      }
      .intro-confianza {
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem 1rem;
        margin-top: 2rem;
      }

      /* Overlays de la imagen: ocultar logo-chip y reducir el badge */
      .intro-logo-chip {
        display: none;
      }
      .intro-foto-badge {
        left: 0.7rem;
        bottom: 0.7rem;
        padding: 0.45rem 0.7rem;
        border-radius: 8px;
      }
      .intro-foto-badge strong {
        font-size: 0.75rem;
      }
      .intro-foto-badge span {
        font-size: 0.65rem;
      }
    }

    /* Diseño de precio limpio y estructurado */
    .price-box {
      margin: 0.9rem 0 1rem;
    }
    .price-main {
      display: flex;
      align-items: baseline;
      gap: 0.15rem;
      font-family: var(--font-h);
    }
    .price-num {
      font-size: 1.7rem;
      font-weight: 800;
      color: var(--text);
      letter-spacing: -1px;
    }
    .price-cur {
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--text);
    }
    .price-fin {
      font-size: 0.78rem;
      color: var(--muted);
      margin-top: 0.15rem;
    }
    .price-fin strong {
      color: var(--red);
      font-weight: 700;
    }
    .price-box--lg .price-num {
      font-size: 2.6rem;
    }
    .price-box--lg .price-cur {
      font-size: 1.6rem;
    }
    .price-box--lg .price-fin {
      font-size: 0.9rem;
    }

    /* Marca de agua "revisado/certificado" */
    .car-cert {
      position: absolute;
      bottom: 10px;
      left: 10px;
      z-index: 3;
      display: flex;
      align-items: center;
      gap: 0.3rem;
      background: rgba(13, 13, 13, 0.78);
      backdrop-filter: blur(4px);
      color: #fff;
      font-size: 0.66rem;
      font-weight: 700;
      letter-spacing: 0.03em;
      padding: 0.32rem 0.6rem;
      border-radius: 20px;
      border: 1px solid rgba(255, 255, 255, 0.15);
    }

    /* Ocasión de la semana */
    .ocasion-card {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 0;
      max-width: 1000px;
      margin: 0 auto;
      background: #fff;
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: var(--shadow-lg);
    }
    .ocasion-img {
      position: relative;
    }
    .ocasion-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      min-height: 340px;
    }
    .ocasion-body {
      padding: 2.5rem;
      display: flex;
      flex-direction: column;
    }
    .ocasion-flag {
      display: inline-block;
      align-self: flex-start;
      background: var(--red);
      color: #fff;
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 0.05em;
      padding: 0.35rem 0.8rem;
      border-radius: 20px;
      margin-bottom: 1.2rem;
    }
    .ocasion-model {
      font-family: var(--font-h);
      font-size: 1.8rem;
      font-weight: 800;
      letter-spacing: -1px;
      margin: 0.1rem 0 0.3rem;
    }

    /* Sección vídeo */
    .video-section {
      background: var(--black);
    }
    .video-inner {
      display: grid;
      grid-template-columns: 1fr 1.4fr;
      gap: 3rem;
      align-items: center;
      max-width: 1100px;
