---
import Base from '../layouts/Base.astro';

// Coches de ejemplo (en Fase 2 vendrán de Supabase)
const destacados = [
  { marca:'Volkswagen', modelo:'Golf 8 Style', anio:2023, motor:'1.0 TSI 110cv', km:'4.500 km', cambio:'Manual', precio:'22.900', cuota:'299', badge:'Km 0', img:'https://images.unsplash.com/photo-1606664515524-ed2f786a0bd6?auto=format&fit=crop&w=700&q=80' },
  { marca:'BMW', modelo:'Serie 3 320d', anio:2021, motor:'190cv Diésel', km:'38.000 km', cambio:'Auto', precio:'31.500', cuota:'419', badge:'Ocasión', img:'https://images.unsplash.com/photo-1555215695-3004980ad54e?auto=format&fit=crop&w=700&q=80' },
  { marca:'Hyundai', modelo:'IONIQ 6', anio:2023, motor:'EV 228cv', km:'12.000 km', cambio:'Auto', precio:'34.900', cuota:'459', badge:'Eléctrico', img:'https://images.unsplash.com/photo-1593941707882-a5bba14938c7?auto=format&fit=crop&w=700&q=80' },
  { marca:'Seat', modelo:'Ateca FR', anio:2024, motor:'190cv', km:'1.200 km', cambio:'DSG', precio:'28.700', cuota:'379', badge:'Km 0', img:'https://images.unsplash.com/photo-1533473359331-0135ef1b58bf?auto=format&fit=crop&w=700&q=80' },
];

// La "Ocasión de la semana" (en Fase 2: el coche marcado como destacado por el admin)
const ocasion = { marca:'Audi', modelo:'A4 40 TFSI S-Tronic', anio:2022, motor:'204cv', km:'27.000 km', cambio:'Automático', precio:'35.400', cuota:'469', img:'https://images.unsplash.com/photo-1614200187524-dc4b892acf16?auto=format&fit=crop&w=900&q=80' };
---
<Base heroNav={true} title="GuadiCar Multimarcas — Coches de Ocasión y Km0 en Villanueva de la Serena (Badajoz)">

<!-- ══ HERO ══ -->
<section id="hero">
  <div class="hero-bg-img"></div>
  <div class="hero-bg-gradient"></div>
  <div class="hero-content">
    <div class="hero-brand">GuadiCar <span>Multimarcas</span></div>
    <div class="hero-eyebrow">Concesionario Multimarca · Villanueva de la Serena (Badajoz)</div>
    <h1>Encuentra tu coche<br><em>ideal</em> al mejor precio</h1>
    <p class="hero-sub">Más de 35 años ayudándote a encontrar el coche perfecto. Vehículos de ocasión y Km0 revisados, garantizados y listos para entregar.</p>
    <div class="hero-ctas">
      <a href="/vehiculos" class="hero-btn-main">Ver vehículos
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <a href="/carta" class="hero-btn-sec">Tu coche a la carta</a>
    </div>
    <div class="hero-badges">
      <div class="hero-badge-item"><div class="hbi-icon">🛡️</div><div class="hbi-text"><span>Garantía incluida</span><small>Mínimo 1 año en todo el stock</small></div></div>
      <div class="hero-badge-sep"></div>
      <div class="hero-badge-item"><div class="hbi-icon">📋</div><div class="hbi-text"><span>Financiación a medida</span><small>Respuesta en menos de 2 horas</small></div></div>
      <div class="hero-badge-sep"></div>
      <div class="hero-badge-item"><div class="hbi-icon">🔍</div><div class="hbi-text"><span>Vehículos certificados</span><small>Cada coche revisado punto por punto</small></div></div>
    </div>
  </div>
</section>

<!-- ══ OCASIÓN DE LA SEMANA ══ -->
<section class="section section--white">
  <div class="s-header" style="text-align:center;max-width:580px;margin:0 auto 2.5rem;">
    <span class="tag">Oferta destacada</span>
    <h2 class="s-title">Ocasión de la semana</h2>
  </div>
  <div class="ocasion-card reveal">
    <div class="ocasion-img">
      <img src={ocasion.img} alt={`${ocasion.marca} ${ocasion.modelo}`} />
      <div class="car-cert">✓ Revisado y certificado</div>
    </div>
    <div class="ocasion-body">
      <div class="ocasion-flag">★ Ocasión de la semana</div>
      <div class="car-brand">{ocasion.marca}</div>
      <div class="ocasion-model">{ocasion.modelo}</div>
      <div class="car-tags">
        <span class="car-tag">{ocasion.anio}</span>
        <span class="car-tag">{ocasion.motor}</span>
        <span class="car-tag">{ocasion.km}</span>
        <span class="car-tag">{ocasion.cambio}</span>
      </div>
      <div class="price-box price-box--lg">
        <div class="price-main"><span class="price-num">{ocasion.precio}</span><span class="price-cur">€</span></div>
        <div class="price-fin">Financiación desde <strong>{ocasion.cuota}€/mes</strong></div>
      </div>
      <a href="/vehiculos" class="hero-btn-main" style="align-self:flex-start;">Ver ficha completa</a>
    </div>
  </div>
</section>

<!-- ══ VEHÍCULOS DESTACADOS ══ -->
<section class="section section--gray">
  <div class="s-header--row">
    <div><span class="tag">Stock destacado</span><h2 class="s-title">Vehículos destacados</h2></div>
    <a href="/vehiculos" style="font-size:0.82rem;font-weight:700;color:var(--red);display:flex;align-items:center;gap:0.3rem;">Ver todo el catálogo →</a>
  </div>
  <div class="cars-grid">
    {destacados.map((c) => (
      <div class="car-card reveal">
        <div class="car-img">
          <img src={c.img} alt={`${c.marca} ${c.modelo}`} />
          <div class="car-img-overlay"></div>
          <div class="car-badge">{c.badge}</div>
          <div class="car-cert">✓ Certificado</div>
        </div>
        <div class="car-body">
          <div class="car-brand">{c.marca}</div>
          <div class="car-name">{c.modelo}</div>
          <div class="car-tags"><span class="car-tag">{c.anio}</span><span class="car-tag">{c.motor}</span><span class="car-tag">{c.km}</span></div>
          <div class="price-box">
            <div class="price-main"><span class="price-num">{c.precio}</span><span class="price-cur">€</span></div>
            <div class="price-fin">Desde <strong>{c.cuota}€/mes</strong></div>
          </div>
          <a href="/vehiculos" class="btn-card">Ver ficha</a>
        </div>
      </div>
    ))}
  </div>
</section>

<!-- ══ VÍDEO INSTALACIONES ══ -->
<section class="section section--dark video-section">
  <div class="video-inner">
    <div class="video-text">
      <span class="tag" style="color:var(--red);">Conócenos</span>
      <h2 class="video-title">Visita nuestras instalaciones</h2>
      <p class="video-desc">[Frase de empresa pendiente de que me la pases] — aquí irá el lema de GuadiCar que acompaña al vídeo de presentación.</p>
    </div>
    <div class="video-wrap reveal">
      <video controls poster="https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?auto=format&fit=crop&w=1200&q=80">
        <source src="https://test-videos.co.uk/vids/bigbuckbunny/mp4/h264/720/Big_Buck_Bunny_720_10s_1MB.mp4" type="video/mp4" />
      </video>
    </div>
  </div>
</section>

<!-- ══ CTA ══ -->
<div class="cta-strip">
  <div><h2>¿Tienes un coche que vender?</h2><p>Tasación gratuita en 24h · Sin compromiso · Pago inmediato</p></div>
  <a href="/contacto" class="btn-white">Solicitar tasación</a>
</div>

<style>
  /* Marca grande en el hero */
  .hero-brand { font-family:var(--font-h); font-size:clamp(1.4rem,3vw,2rem); font-weight:800; color:#fff; letter-spacing:-0.5px; margin-bottom:1.2rem; }
  .hero-brand span { color:var(--red); }

  /* Diseño de precio limpio y estructurado */
  .price-box { margin:0.9rem 0 1rem; }
  .price-main { display:flex; align-items:baseline; gap:0.15rem; font-family:var(--font-h); }
  .price-num { font-size:1.7rem; font-weight:800; color:var(--text); letter-spacing:-1px; }
  .price-cur { font-size:1.1rem; font-weight:700; color:var(--text); }
  .price-fin { font-size:0.78rem; color:var(--muted); margin-top:0.15rem; }
  .price-fin strong { color:var(--red); font-weight:700; }
  .price-box--lg .price-num { font-size:2.6rem; }
  .price-box--lg .price-cur { font-size:1.6rem; }
  .price-box--lg .price-fin { font-size:0.9rem; }

  /* Marca de agua "revisado/certificado" */
  .car-cert { position:absolute; bottom:10px; left:10px; z-index:3; display:flex; align-items:center; gap:0.3rem;
    background:rgba(13,13,13,0.78); backdrop-filter:blur(4px); color:#fff; font-size:0.66rem; font-weight:700;
    letter-spacing:0.03em; padding:0.32rem 0.6rem; border-radius:20px; border:1px solid rgba(255,255,255,0.15); }

  /* Ocasión de la semana */
  .ocasion-card { display:grid; grid-template-columns:1.2fr 1fr; gap:0; max-width:1000px; margin:0 auto;
    background:#fff; border:1px solid var(--border); border-radius:var(--radius-lg); overflow:hidden; box-shadow:var(--shadow-lg); }
  .ocasion-img { position:relative; }
  .ocasion-img img { width:100%; height:100%; object-fit:cover; min-height:340px; }
  .ocasion-body { padding:2.5rem; display:flex; flex-direction:column; }
  .ocasion-flag { display:inline-block; align-self:flex-start; background:var(--red); color:#fff; font-size:0.7rem; font-weight:800;
    letter-spacing:0.05em; padding:0.35rem 0.8rem; border-radius:20px; margin-bottom:1.2rem; }
  .ocasion-model { font-family:var(--font-h); font-size:1.8rem; font-weight:800; letter-spacing:-1px; margin:0.1rem 0 0.3rem; }

  /* Sección vídeo */
  .video-section { background:var(--black); }
  .video-inner { display:grid; grid-template-columns:1fr 1.4fr; gap:3rem; align-items:center; max-width:1100px; margin:0 auto; }
  .video-title { font-family:var(--font-h); font-size:clamp(1.8rem,3.5vw,2.6rem); font-weight:800; color:#fff; letter-spacing:-1px; line-height:1.05; margin:0.6rem 0 1rem; }
  .video-desc { color:rgba(255,255,255,0.65); line-height:1.7; font-size:0.95rem; }
  .video-wrap { border-radius:var(--radius-lg); overflow:hidden; box-shadow:var(--shadow-lg); aspect-ratio:16/9; }
  .video-wrap video { width:100%; height:100%; object-fit:cover; display:block; }

  @media (max-width:820px) {
    .ocasion-card, .video-inner { grid-template-columns:1fr; }
    .ocasion-img img { min-height:240px; }
  }
</style>

</Base>