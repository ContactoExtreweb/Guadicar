---
import Base from '../layouts/Base.astro'
import Newsletter from '../components/Newsletter.astro'
import Resenas from '../components/Resenas.astro'
import TarjetaCoche from '../components/TarjetaCoche.astro'
import { getVehiculos, fmt } from '../lib/coches.js'
import { cachearEnCDN } from '../lib/cache.js'

export const prerender = false // para mostrar los coches reales y que se actualice al añadirlos

// Una sola consulta para toda la home: con el stock de un concesionario sale
// más barato traerlo entero y repartirlo aquí que hacer una por bloque.
// ponytail: si el stock pasara de varios cientos, pedir cada bloque aparte
const coches = await getVehiculos() // publicados, el más reciente primero
const ocasion = coches.find((c) => c.ocasionSemana) ?? null
const destacados = coches.filter((c) => c.destacado).slice(0, 4)
const publicados = coches.filter((c) => !c.destacado).slice(0, 4)

// "Explora el stock": accesos al catálogo ya filtrado, con cuántos hay
const contar = (campo: 'marca' | 'carroceria') =>
  [
    ...coches
      .reduce(
        (m, c) => (c[campo] ? m.set(c[campo], (m.get(c[campo]) ?? 0) + 1) : m),
        new Map(),
      )
      .entries(),
  ].sort((a, b) => b[1] - a[1])
const porMarca = contar('marca')
const porCarroceria = contar('carroceria')
// Mismos cortes que los desplegables de precio del catálogo
const conPrecio = coches.filter((c) => !c.precioOculto && c.precio > 0)
const porPresupuesto = [
  { texto: 'Hasta 15.000 €', url: 'pmax=15000', max: 15000 },
  { texto: '15.000 – 25.000 €', url: 'pmin=15000&pmax=25000', min: 15000, max: 25000 },
  { texto: 'Más de 25.000 €', url: 'pmin=25000', min: 25000 },
]
  .map((p) => ({
    ...p,
    n: conPrecio.filter(
      (c) => (!p.min || c.precio >= p.min) && (!p.max || c.precio <= p.max),
    ).length,
  }))
  .filter((p) => p.n > 0)

// Preguntas frecuentes: solo datos que ya figuran en la web
const FAQ = [
  {
    p: '¿Los coches tienen garantía?',
    r: 'Sí. Todos nuestros vehículos se entregan revisados y certificados, con una garantía mínima de 1 año.',
  },
  {
    p: '¿Puedo financiar el coche?',
    r: 'Sí. Te preparamos una financiación a medida, con plazos de hasta 120 meses y una TAE orientativa del 7,99 %, sujeta a aprobación de la entidad financiera. En la ficha de cada coche puedes calcular tu cuota.',
  },
  {
    p: '¿Compráis coches? ¿Podéis tasar el mío?',
    r: 'Sí. Tasamos tu coche gratis en 24 horas y sin compromiso, y si llegamos a un acuerdo el pago es inmediato.',
  },
  {
    p: 'No encuentro el coche que busco, ¿qué hago?',
    r: 'Usa nuestro servicio a la carta: dinos qué coche buscas y tu presupuesto, y en menos de 48 horas te contactamos con opciones.',
  },
  {
    p: '¿Puedo ver el coche antes de comprarlo?',
    r: 'Claro. Ven a vernos al Polígono Cagancha, 39, en Villanueva de la Serena, o llámanos al 722 49 61 24 y te lo tenemos preparado.',
  },
  {
    p: '¿Qué horario tenéis?',
    r: 'De lunes a viernes, de 10:00 a 14:00 y de 17:00 a 21:00. Los sábados, de 10:00 a 13:00. Los domingos cerramos.',
  },
]
const schemaFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((f) => ({
    '@type': 'Question',
    name: f.p,
    acceptedAnswer: { '@type': 'Answer', text: f.r },
  })),
}

cachearEnCDN(Astro.response.headers)
---

<Base
  heroNav={false}
  title='GuadiCar Multimarcas | Concesionario de coches de segunda mano en Villanueva de la Serena'
  description='Concesionario de coches de segunda mano, ocasión y Km0 en Villanueva de la Serena (Badajoz). Vehículos revisados y certificados, con garantía mínima de 1 año y financiación a medida.'
>
  <!-- Hero: vídeo de las instalaciones a pantalla completa. El vídeo arranca por
       JS (no con autoplay) para respetar "reducir movimiento" y el ahorro de
       datos; si no arranca, se queda la portada. -->
  <section id='hero' class='hv'>
    <video
      class='hv-video'
      muted
      loop
      playsinline
      preload='none'
      poster='/hero/hero-poster.jpg'
      aria-hidden='true'
    >
      <source
        src='/hero/hero-movil.mp4'
        type='video/mp4'
        media='(max-width: 700px)'
      />
      <source src='/hero/hero.mp4' type='video/mp4' />
    </video>
    <div class='hv-velo' aria-hidden='true'></div>

    <div class='hv-centro'>
      <h1 class='hv-titulo'>
        <span class='hv-eyebrow'
          >Coches de segunda mano en Villanueva de la Serena</span
        >
        Tu próximo coche está en <em>GuadiCar</em>
      </h1>
      <p class='hv-lead'>
        Concesionario multimarca con más de 35 años ayudando a nuestros vecinos
        a encontrar el coche que necesitan. Vehículos de ocasión y Km0 revisados
        uno a uno, sin letra pequeña y con atención personal de principio a fin.
      </p>
      <div class='hv-ctas'>
        <a href='/vehiculos/' class='hero-btn-main'
          >Ver coches disponibles
          <svg
            width='17'
            height='17'
            fill='none'
            stroke='currentColor'
            stroke-width='2.5'
            viewBox='0 0 24 24'
            aria-hidden='true'><path d='M5 12h14M12 5l7 7-7 7'></path></svg
          >
        </a>
        <a href='tel:+34722496124' class='hv-tel'>
          <svg
            width='18'
            height='18'
            fill='none'
            stroke='currentColor'
            stroke-width='2'
            viewBox='0 0 24 24'
            aria-hidden='true'
            ><path
              d='M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z'
            ></path></svg
          >
          <span><small>Contacta al</small><strong>722 49 61 24</strong></span>
        </a>
      </div>
      <a href='/contacto/' class='hv-ubicacion'
        >Polígono Cagancha, 39 · Villanueva de la Serena (Badajoz)</a
      >
    </div>

    <ul class='hv-confianza'>
      <li><strong>+35</strong><span>años en el sector</span></li>
      <li><strong>1 año</strong><span>de garantía mínima</span></li>
      <li><strong>100%</strong><span>coches certificados y revisados</span></li>
      <li>
        <strong>Atención</strong><span>personalizada de principio a fin</span>
      </li>
    </ul>

    <button type='button' class='hv-pausa' aria-label='Pausar el vídeo' hidden>
      <svg class='hv-i-pausa' viewBox='0 0 24 24' aria-hidden='true'
        ><rect x='6' y='5' width='4' height='14' rx='1'></rect><rect
          x='14'
          y='5'
          width='4'
          height='14'
          rx='1'></rect></svg
      >
      <svg class='hv-i-play' viewBox='0 0 24 24' aria-hidden='true'
        ><path d='M8 5.5v13a1 1 0 0 0 1.5.86l10.4-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z'
        ></path></svg
      >
    </button>
  </section>

  <!-- Coches que este visitante vio hace poco (se guardan en su navegador al
       abrir una ficha). Oculto si no hay ninguno. -->
  <section class='section section--white' id='vistos' hidden>
    <div class='s-header--row'>
      <div>
        <span class='tag'>Para ti</span>
        <h2 class='s-title'>Continúa donde lo dejaste</h2>
      </div>
    </div>
    <div class='cars-grid' id='vistos-grid'></div>
  </section>

  {
    ocasion && (
      <section class='section section--white'>
        <div
          class='s-header'
          style='text-align:center;max-width:580px;margin:0 auto 2.5rem;'
        >
          <span class='tag'>Oferta destacada</span>
          <h2 class='s-title'>Ocasión de la semana</h2>
        </div>
        <div class='ocasion-card reveal'>
          <div class='ocasion-img'>
            <img
              src={ocasion.fotos?.[0] || '/placeholder-coche.svg'}
              alt={`${ocasion.marca} ${ocasion.modelo}`}
            />
            {ocasion.certificado && (
              <div class='car-cert'>✓ Revisado y certificado</div>
            )}
            {ocasion.reservado && <div class='car-reservado'>Reservado</div>}
          </div>
          <div class='ocasion-body'>
            <div class='ocasion-flag'>★ Ocasión de la semana</div>
            <div class='car-brand'>{ocasion.marca}</div>
            <div class='ocasion-model'>{ocasion.modelo}</div>
            <div class='car-tags'>
              <span class='car-tag'>{ocasion.anio}</span>
              <span class='car-tag'>{fmt(ocasion.km)} km</span>
              <span class='car-tag'>{ocasion.combustible}</span>
              <span class='car-tag'>{ocasion.cambio}</span>
            </div>
            <div class='price-box price-box--lg'>
              {ocasion.precioOculto ? (
                <>
                  <div class='price-consultar' style='color:var(--text);'>
                    Precio a consultar
                  </div>
                  <div class='price-fin'>
                    Llámanos y te informamos sin compromiso
                  </div>
                </>
              ) : (
                <>
                  <div class='price-main'>
                    <span class='price-num'>{fmt(ocasion.precio)}</span>
                    <span class='price-cur'>€</span>
                  </div>
                  <div class='price-fin'>
                    Financiación desde <strong>{ocasion.cuota}€/mes*</strong>
                  </div>
                </>
              )}
            </div>

            <a
              href={`/vehiculos/${ocasion.slug}`}
              class='hero-btn-main'
              style='align-self:flex-start;'
            >
              Ver ficha completa
            </a>
          </div>
        </div>
      </section>
    )
  }

  {
    destacados.length > 0 && (
      <section class='section section--gray'>
        <div class='s-header--row'>
          <div>
            <>
              <span class='tag'>Stock destacado</span>
              <h2 class='s-title'>Vehículos destacados</h2>
            </>
          </div>

          <a
            href='/vehiculos/'
            style='font-size:0.82rem;font-weight:700;color:var(--red);display:flex;align-items:center;gap:0.3rem;'
          >
            Ver todo el catálogo →
          </a>
        </div>
        <div class='cars-grid'>
          {destacados.map((c) => <TarjetaCoche c={c} class='reveal' />)}
        </div>
      </section>
    )
  }
  {
    publicados.length > 0 && (
      <section class='section section--white'>
        <div class='s-header--row'>
          <div>
            <>
              <span class='tag'>Recién llegados</span>
              <h2 class='s-title'>Últimas incorporaciones</h2>
            </>
          </div>

          <a
            href='/vehiculos/'
            style='font-size:0.82rem;font-weight:700;color:var(--red);display:flex;align-items:center;gap:0.3rem;'
          >
            Ver todos los coches →
          </a>
        </div>
        <div class='cars-grid'>
          {publicados.map((c) => <TarjetaCoche c={c} class='reveal' />)}
        </div>
      </section>
    )
  }
  {
    coches.length > 0 && (
      <section class='section section--gray'>
        <div class='s-header explora-cab'>
          <span class='tag'>Nuestro stock</span>
          <h2 class='s-title'>Encuentra tu coche más rápido</h2>
        </div>
        <div class='explora'>
          <div class='explora-col'>
            <h3>Por marca</h3>
            <div class='explora-chips'>
              {porMarca.map(([m, n]) => (
                <a href={`/vehiculos/?marca=${encodeURIComponent(m)}`} class='explora-chip'>
                  {m}
                  <span>{n}</span>
                </a>
              ))}
            </div>
          </div>
          <div class='explora-col'>
            <h3>Por tipo</h3>
            <div class='explora-chips'>
              {porCarroceria.map(([t, n]) => (
                <a href={`/vehiculos/?carroceria=${encodeURIComponent(t)}`} class='explora-chip'>
                  {t}
                  <span>{n}</span>
                </a>
              ))}
            </div>
          </div>
          {porPresupuesto.length > 0 && (
            <div class='explora-col'>
              <h3>Por presupuesto</h3>
              <div class='explora-chips'>
                {porPresupuesto.map((p) => (
                  <a href={`/vehiculos/?${p.url}`} class='explora-chip'>
                    {p.texto}
                    <span>{p.n}</span>
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      </section>
    )
  }
  <section class='section section--white'>
    <Resenas />
  </section>
  <section class='section section--gray'>
    <div class='s-header explora-cab'>
      <span class='tag'>Resolvemos tus dudas</span>
      <h2 class='s-title'>Preguntas frecuentes</h2>
    </div>
    <div class='faq'>
      {
        FAQ.map((f) => (
          <details class='faq-item'>
            <summary>{f.p}</summary>
            <p>{f.r}</p>
          </details>
        ))
      }
    </div>
    <script type='application/ld+json' set:html={JSON.stringify(schemaFaq)} />
  </section>
  <section class='section section--dark video-section'>
    <div class='video-inner'>
      <div class='video-text'>
        <span class='tag' style='color:var(--red);'>Conócenos</span>
        <h2 class='video-title'>Visita nuestras instalaciones</h2>
        <p class='video-desc'>
          Más de tres décadas ayudando a nuestros clientes a moverse con un
          coche de confianza. Cada vehículo de nuestras instalaciones está
          revisado y certificado punto por punto. Te invitamos a visitarnos sin
          compromiso.
        </p>
      </div>
      <div class='video-wrap reveal'>
        <video controls>
          <source src='/instalaciones_guadicar.mp4' type='video/mp4' />
        </video>
      </div>
    </div>
  </section>

  <section class='section section--gray'>
    <Newsletter variant='section' />
  </section>

  <div class='cta-strip'>
    <div>
      <h2>¿Tienes un coche que vender?</h2><p>
        Tasación gratuita en 24h · Sin compromiso · Pago inmediato
      </p>
    </div>
    <a href='/contacto/' class='btn-white'>Solicitar tasación</a>
  </div>

  <style>
    /* ───── HERO CON VÍDEO ───── */
    .hv {
      position: relative;
      isolation: isolate;
      min-height: 100vh;
      min-height: 100svh; /* en móvil, sin contar las barras del navegador */
      display: flex;
      flex-direction: column;
      padding: 7.5rem 1.5rem 1.5rem;
      color: #fff;
      overflow: hidden;
      background: #0d0d0d url('/hero/hero-poster.jpg') center / cover no-repeat;
    }
    .hv-video {
      position: absolute;
      inset: 0;
      z-index: -2;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
    }
    /* Velo oscuro: que el texto se lea sobre cualquier plano del vídeo y que
       la baja resolución (1024 px) no se note en pantallas grandes */
    .hv-velo {
      position: absolute;
      inset: 0;
      z-index: -1;
      background:
        radial-gradient(ellipse at 50% 45%, rgba(0, 0, 0, 0.25), rgba(0, 0, 0, 0.6) 75%),
        linear-gradient(180deg, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0.15) 35%, rgba(0, 0, 0, 0.8) 100%);
    }

    .hv-centro {
      margin: auto;
      max-width: 920px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.4rem;
      text-align: center;
    }
    .hv-titulo {
      margin: 0;
      font-family: var(--font-h);
      font-size: clamp(2.3rem, 6.4vw, 5.2rem);
      font-weight: 900;
      line-height: 1.02;
      letter-spacing: -0.02em;
      text-wrap: balance;
      text-shadow: 0 2px 30px rgba(0, 0, 0, 0.35);
    }
    .hv-titulo em {
      font-style: normal;
      color: var(--red);
    }
    .hv-eyebrow {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      margin-bottom: 1.1rem;
      font-family: var(--font);
      font-size: clamp(0.7rem, 1.3vw, 0.82rem);
      font-weight: 700;
      letter-spacing: 0.16em;
      line-height: 1.4;
      text-transform: uppercase;
      text-shadow: none;
      color: rgba(255, 255, 255, 0.88);
    }
    .hv-eyebrow::before {
      content: '';
      flex: 0 0 auto;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--red);
      box-shadow: 0 0 0 4px rgba(204, 28, 28, 0.3);
    }
    .hv-lead {
      max-width: 640px;
      margin: 0;
      font-size: clamp(0.98rem, 1.5vw, 1.12rem);
      line-height: 1.65;
      color: rgba(255, 255, 255, 0.85);
    }
    .hv-ctas {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.8rem;
      margin-top: 0.4rem;
    }
    .hv-tel {
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.65rem 1.4rem;
      border: 1px solid rgba(255, 255, 255, 0.35);
      border-radius: 4px;
      background: rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(10px);
      color: #fff;
      text-align: left;
      transition: background 0.2s ease, border-color 0.2s ease;
    }
    .hv-tel:hover {
      background: rgba(255, 255, 255, 0.16);
      border-color: rgba(255, 255, 255, 0.6);
    }
    .hv-tel small {
      display: block;
      font-size: 0.66rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      opacity: 0.75;
    }
    .hv-tel strong {
      font-size: 1.05rem;
    }
    .hv-ubicacion {
      font-size: 0.82rem;
      color: rgba(255, 255, 255, 0.7);
    }
    .hv-ubicacion:hover {
      color: #fff;
      text-decoration: underline;
    }

    /* Datos de confianza: barra de cristal al pie del hero */
    .hv-confianza {
      width: min(1100px, 100%);
      margin: 2.5rem auto 0;
      padding: 0;
      list-style: none;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.07);
      backdrop-filter: blur(14px);
    }
    .hv-confianza li {
      padding: 1.1rem 1rem;
      text-align: center;
    }
    .hv-confianza li + li {
      border-left: 1px solid rgba(255, 255, 255, 0.12);
    }
    .hv-confianza strong {
      display: block;
      font-family: var(--font-h);
      font-size: clamp(1.25rem, 2.3vw, 1.7rem);
      font-weight: 800;
    }
    .hv-confianza span {
      font-size: 0.78rem;
      color: rgba(255, 255, 255, 0.72);
    }

    /* Pausa: obligatorio dar control sobre un vídeo que se mueve solo */
    .hv-pausa {
      position: absolute;
      top: 6rem;
      right: 1.5rem;
      width: 40px;
      height: 40px;
      display: grid;
      place-items: center;
      padding: 0;
      border: 1px solid rgba(255, 255, 255, 0.3);
      border-radius: 50%;
      background: rgba(0, 0, 0, 0.35);
      backdrop-filter: blur(8px);
      color: #fff;
      cursor: pointer;
    }
    .hv-pausa[hidden] {
      display: none;
    }
    .hv-pausa svg {
      width: 16px;
      height: 16px;
      fill: currentColor;
    }
    .hv-pausa .hv-i-play,
    .hv-pausa.pausado .hv-i-pausa {
      display: none;
    }
    .hv-pausa.pausado .hv-i-play {
      display: block;
    }

    /* Entrada escalonada del contenido */
    @media (prefers-reduced-motion: no-preference) {
      .hv-centro > *,
      .hv-confianza {
        animation: hvEntra 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
      }
      .hv-centro > :nth-child(2) {
        animation-delay: 0.12s;
      }
      .hv-centro > :nth-child(3) {
        animation-delay: 0.24s;
      }
      .hv-centro > :nth-child(4) {
        animation-delay: 0.36s;
      }
      .hv-confianza {
        animation-delay: 0.5s;
      }
      @keyframes hvEntra {
        from {
          opacity: 0;
          transform: translateY(18px);
        }
      }
    }

    @media (max-width: 700px) {
      .hv {
        padding: 6.2rem 1rem 1rem;
      }
      /* Más oscuro arriba: en vertical el letrero de la fachada queda justo
         detrás del titular */
      .hv-velo {
        background: linear-gradient(
          180deg,
          rgba(0, 0, 0, 0.72) 0%,
          rgba(0, 0, 0, 0.5) 45%,
          rgba(0, 0, 0, 0.82) 100%
        );
      }
      .hv-centro {
        gap: 0.9rem;
      }
      .hv-titulo {
        font-size: clamp(2.05rem, 9.5vw, 2.6rem);
      }
      .hv-eyebrow {
        margin-bottom: 0.8rem;
        letter-spacing: 0.1em;
      }
      .hv-lead {
        font-size: 0.92rem;
        line-height: 1.55;
      }
      .hv-ctas {
        width: 100%;
        flex-direction: column;
        gap: 0.6rem;
        margin-top: 0.2rem;
      }
      .hv-ctas > * {
        justify-content: center;
      }
      .hv-ctas .hero-btn-main {
        padding: 0.85rem 1.5rem;
        font-size: 1rem;
      }
      .hv-tel {
        padding: 0.5rem 1.2rem;
      }
      .hv-confianza {
        margin-top: 1.2rem;
        grid-template-columns: 1fr 1fr;
      }
      .hv-confianza li {
        padding: 0.65rem 0.5rem;
      }
      .hv-confianza li + li {
        border-left: none;
      }
      .hv-confianza li:nth-child(even) {
        border-left: 1px solid rgba(255, 255, 255, 0.12);
      }
      .hv-confianza li:nth-child(n + 3) {
        border-top: 1px solid rgba(255, 255, 255, 0.12);
      }
      .hv-confianza span {
        font-size: 0.72rem;
      }
      .hv-pausa {
        top: 5.6rem;
        right: 1rem;
        width: 36px;
        height: 36px;
      }
    }

    /* Móvil en horizontal / pantallas bajas: menos aire para que quepa */
    @media (max-height: 520px) and (orientation: landscape) {
      .hv {
        padding-top: 5.5rem;
      }
      .hv-titulo {
        font-size: clamp(1.9rem, 5vw, 2.6rem);
      }
      .hv-lead {
        font-size: 0.9rem;
      }
      .hv-confianza {
        margin-top: 1.2rem;
      }
    }

    /* Diseño de precio limpio y estructurado */
    .price-box {
      margin: 0.9rem 0 1rem;
    }
    .price-main {
      display: flex;
      align-items: baseline;
      gap: 0.15rem;
      font-family: var(--font-h);
    }
    .price-num {
      font-size: 1.7rem;
      font-weight: 800;
      color: var(--text);
      letter-spacing: -1px;
    }
    .price-cur {
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--text);
    }
    .price-fin {
      font-size: 0.78rem;
      color: var(--muted);
      margin-top: 0.15rem;
    }
    .price-fin strong {
      color: var(--red);
      font-weight: 700;
    }
    .price-box--lg .price-num {
      font-size: 2.6rem;
    }
    .price-box--lg .price-cur {
      font-size: 1.6rem;
    }
    .price-box--lg .price-fin {
      font-size: 0.9rem;
    }

    /* Marca de agua "revisado/certificado" */
    .car-cert {
      position: absolute;
      bottom: 10px;
      left: 10px;
      z-index: 3;
      display: flex;
      align-items: center;
      gap: 0.3rem;
      background: rgba(13, 13, 13, 0.78);
      backdrop-filter: blur(4px);
      color: #fff;
      font-size: 0.66rem;
      font-weight: 700;
      letter-spacing: 0.03em;
      padding: 0.32rem 0.6rem;
      border-radius: 20px;
      border: 1px solid rgba(255, 255, 255, 0.15);
    }

    /* Ocasión de la semana */
    .ocasion-card {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      gap: 0;
      max-width: 1000px;
      margin: 0 auto;
      background: #fff;
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: var(--shadow-lg);
    }
    .ocasion-img {
      position: relative;
    }
    .ocasion-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      min-height: 340px;
    }
    .ocasion-body {
      padding: 2.5rem;
      display: flex;
      flex-direction: column;
    }
    .ocasion-flag {
      display: inline-block;
      align-self: flex-start;
      background: var(--red);
      color: #fff;
      font-size: 0.7rem;
      font-weight: 800;
      letter-spacing: 0.05em;
      padding: 0.35rem 0.8rem;
      border-radius: 20px;
      margin-bottom: 1.2rem;
    }
    .ocasion-model {
      font-family: var(--font-h);
      font-size: 1.8rem;
      font-weight: 800;
      letter-spacing: -1px;
      margin: 0.1rem 0 0.3rem;
    }

    /* Sección vídeo */
    .video-section {
      background: var(--black);
    }
    .video-inner {
      display: grid;
      grid-template-columns: 1fr 1.4fr;
      gap: 3rem;
      align-items: center;
      max-width: 1100px;
      margin: 0 auto;
    }
    .video-title {
      font-family: var(--font-h);
      font-size: clamp(1.8rem, 3.5vw, 2.6rem);
      font-weight: 800;
      color: #fff;
      letter-spacing: -1px;
      line-height: 1.05;
      margin: 0.6rem 0 1rem;
    }
    .video-desc {
      color: rgba(255, 255, 255, 0.65);
      line-height: 1.7;
      font-size: 0.95rem;
    }
    .video-wrap {
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: var(--shadow-lg);
      aspect-ratio: 16/9;
    }
    .video-wrap video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    @media (max-width: 820px) {
      .ocasion-card,
      .video-inner {
        grid-template-columns: 1fr;
      }
      .ocasion-img img {
        min-height: 240px;
      }
    }

    /* ───── Explora el stock y preguntas frecuentes ───── */
    .explora-cab {
      max-width: 620px;
      margin: 0 auto 2.2rem;
      text-align: center;
    }
    .explora {
      max-width: 1100px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1.2rem;
    }
    .explora-col {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 1.4rem;
    }
    .explora-col h3 {
      margin: 0 0 1rem;
      font-family: var(--font-h);
      font-size: 1rem;
      font-weight: 800;
    }
    .explora-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }
    .explora-chip {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 0.8rem;
      border: 1px solid var(--border);
      border-radius: 999px;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--text);
      transition: border-color 0.2s ease, color 0.2s ease;
    }
    .explora-chip span {
      min-width: 1.4rem;
      padding: 0.05rem 0.4rem;
      border-radius: 999px;
      background: var(--gray);
      font-size: 0.72rem;
      text-align: center;
      color: var(--muted);
    }
    .explora-chip:hover {
      border-color: var(--red);
      color: var(--red);
    }

    .faq {
      max-width: 780px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }
    .faq-item {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 12px;
    }
    .faq-item summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 1rem 1.2rem;
      font-weight: 700;
      cursor: pointer;
      list-style: none;
    }
    .faq-item summary::-webkit-details-marker {
      display: none;
    }
    .faq-item summary::after {
      content: '+';
      flex: 0 0 auto;
      font-size: 1.3rem;
      font-weight: 400;
      color: var(--red);
      transition: transform 0.2s ease;
    }
    .faq-item[open] summary::after {
      transform: rotate(45deg);
    }
    .faq-item p {
      margin: 0;
      padding: 0 1.2rem 1.1rem;
      color: var(--muted);
      line-height: 1.6;
    }
  </style>

  <script>
    // @ts-nocheck
    // ── Vídeo del hero ──
    // Solo arranca si el visitante no pidió reducir movimiento ni ahorrar
    // datos; si no, se queda la portada.
    const video = document.querySelector('.hv-video')
    const pausa = document.querySelector('.hv-pausa')
    const reducir = matchMedia('(prefers-reduced-motion: reduce)').matches
    const ahorro = navigator.connection?.saveData

    if (video && !reducir && !ahorro) {
      video.preload = 'auto'
      video
        .play()
        .then(() => (pausa.hidden = false))
        .catch(() => {}) // navegador sin autoplay: se queda la portada
      pausa.addEventListener('click', () =>
        video.paused ? video.play() : video.pause(),
      )
      const reflejar = () => {
        pausa.classList.toggle('pausado', video.paused)
        pausa.setAttribute(
          'aria-label',
          video.paused ? 'Reproducir el vídeo' : 'Pausar el vídeo',
        )
      }
      video.addEventListener('play', reflejar)
      video.addEventListener('pause', reflejar)
    }

    // ── Continúa donde lo dejaste ──
    // La ficha guarda en este navegador los últimos coches vistos
    // (gc_vistos). Aquí se piden sus datos actuales a Supabase: así el precio
    // es el de hoy y los coches ya vendidos (despublicados) no aparecen.
    const esc = (s) =>
      String(s ?? '').replace(
        /[&<>"']/g,
        (c) =>
          ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c],
      )
    const fmt = (n) => Number(n).toLocaleString('es-ES')
    // Los mismos iconos que TarjetaCoche.astro
    const svg = (d) => `<svg viewBox="0 0 24 24" aria-hidden="true">${d}</svg>`
    const ICONOS = {
      anio: svg('<rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 9h18M8 3v4M16 3v4"></path>'),
      km: svg('<path d="M4 18a8 8 0 1 1 16 0"></path><path d="M12 18l4-5"></path>'),
      comb: svg('<path d="M5 21V5a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v16M4 21h12M9 9h4"></path><path d="M15 8l3 3v6a1.5 1.5 0 0 0 3 0V9l-2-2"></path>'),
      cambio: svg('<circle cx="12" cy="12" r="3"></circle><path d="M12 3v3M12 18v3M3 12h3M18 12h3"></path>'),
    }

    ;(async () => {
      let slugs = []
      try {
        slugs = JSON.parse(localStorage.getItem('gc_vistos') || '[]')
      } catch {}
      if (!Array.isArray(slugs) || !slugs.length) return

      const url = import.meta.env.PUBLIC_SUPABASE_URL
      const key = import.meta.env.PUBLIC_SUPABASE_ANON_KEY
      const lista = slugs.map(encodeURIComponent).join(',')
      const res = await fetch(
        `${url}/rest/v1/vehiculos?select=slug,marca,modelo,version,anio,km,combustible,cambio,fotos,precio,precio_oculto,reservado&publicado=eq.true&slug=in.(${lista})`,
        { headers: { apikey: key, Authorization: `Bearer ${key}` } },
      ).catch(() => null)
      if (!res?.ok) return
      const coches = await res.json()

      // Mismo orden que se vieron; los que ya no están publicados se olvidan
      const porSlug = new Map(coches.map((c) => [c.slug, c]))
      const vigentes = slugs.filter((s) => porSlug.has(s))
      try {
        localStorage.setItem('gc_vistos', JSON.stringify(vigentes))
      } catch {}
      if (!vigentes.length) return

      document.getElementById('vistos-grid').innerHTML = vigentes
        .slice(0, 4)
        .map((s) => {
          const c = porSlug.get(s)
          const oculto = c.precio_oculto || c.reservado
          return `
          <a href="/vehiculos/${esc(c.slug)}" class="car-card">
            <div class="car-img">
              <img src="${esc(c.fotos?.[0] || '/placeholder-coche.svg')}" alt="${esc(c.marca)} ${esc(c.modelo)}" loading="lazy" />
              <div class="car-img-overlay"></div>
              ${c.reservado ? '<div class="car-reservado">Reservado</div>' : ''}
            </div>
            <div class="car-body">
              <div class="car-brand">${esc(c.marca)}</div>
              <div class="car-name">${esc(c.modelo)}</div>
              ${c.version ? `<div class="car-version">${esc(c.version)}</div>` : ''}
              <ul class="car-datos">
                ${[
                  [ICONOS.anio, c.anio],
                  [ICONOS.km, c.km != null ? fmt(c.km) + ' km' : ''],
                  [ICONOS.comb, c.combustible],
                  [ICONOS.cambio, c.cambio],
                ]
                  .filter(([, d]) => d)
                  .map(([icono, d]) => `<li>${icono}${esc(d)}</li>`)
                  .join('')}
              </ul>
              <div class="car-price-row">
                ${
                  oculto
                    ? '<div class="car-price-consultar">Precio a consultar</div>'
                    : `<div class="car-price-main"><span class="car-price">${fmt(c.precio)}<span style="font-size:1rem;">€</span></span></div>`
                }
              </div>
              <span class="btn-card">Ver ficha</span>
            </div>
          </a>`
        })
        .join('')
      document.getElementById('vistos').hidden = false
    })()
  </script>
</Base>
