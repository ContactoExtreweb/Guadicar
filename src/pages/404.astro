---
import Base from '../layouts/Base.astro'
---

<Base
  title='Página no encontrada | GuadiCar'
  description='El vehículo o la página que buscas no está disponible.'
  heroNav={false}
>
  <section class='error-section'>
    <div class='error-container reveal'>
      <span class='error-code'>404</span>
      <h1 class='error-title'>Vehículo no encontrado</h1>
      <p class='error-desc'>
        Es posible que el vehículo que buscas ya se haya vendido o que la página
        ya no exista.
      </p>
      <p class='error-redirect'>
        Serás redirigido a nuestro catálogo en <span id='countdown'>10</span> segundos...
      </p>
      <a href='/vehiculos' class='hero-btn-main'> Ver vehículos disponibles </a>
    </div>
  </section>

  <style>
    .error-section {
      padding: 10rem 1.5rem 6rem;
      min-height: 65vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      background: linear-gradient(180deg, var(--gray) 0%, #fff 100%);
    }
    .error-container {
      max-width: 600px;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .error-code {
      font-family: var(--font-h);
      font-size: clamp(5rem, 10vw, 7rem);
      font-weight: 900;
      color: var(--red);
      line-height: 1;
      margin-bottom: 0.5rem;
      letter-spacing: -3px;
    }
    .error-title {
      font-family: var(--font-h);
      font-size: clamp(2rem, 5vw, 2.8rem);
      font-weight: 800;
      color: var(--text);
      margin: 0 0 1rem;
      letter-spacing: -1px;
    }
    .error-desc {
      font-size: 1.15rem;
      line-height: 1.6;
      color: var(--muted);
      margin: 0 0 1.5rem;
    }
    .error-redirect {
      font-size: 0.95rem;
      color: var(--text);
      font-weight: 600;
      margin: 0 0 2.5rem;
      padding: 0.8rem 1.2rem;
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 12px;
      box-shadow: var(--shadow);
    }
    #countdown {
      color: var(--red);
      font-weight: 800;
      font-size: 1.1rem;
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      let seconds = 10
      const countdownEl = document.getElementById('countdown')

      const interval = setInterval(() => {
        seconds--
        if (countdownEl) {
          countdownEl.textContent = seconds.toString()
        }

        if (seconds <= 0) {
          clearInterval(interval)
          window.location.href = '/vehiculos'
        }
      }, 1000)
    })
  </script>
</Base>
