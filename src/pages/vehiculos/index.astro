---
export const prerender = false
import Base from '../../layouts/Base.astro'
import TarjetaCoche from '../../components/TarjetaCoche.astro'
import { getVehiculos } from '../../lib/coches.js'
import { cachearEnCDN } from '../../lib/cache.js'

const vehiculos = await getVehiculos()
cachearEnCDN(Astro.response.headers)
const unicos = (arr: any[]) => [...new Set(arr.filter(Boolean))] as any[]
const marcas = unicos(vehiculos.map((v: any) => v.marca)).sort()
const carrocerias = unicos(vehiculos.map((v: any) => v.carroceria)).sort()
const combustibles = unicos(vehiculos.map((v: any) => v.combustible)).sort()
const cambios = unicos(vehiculos.map((v: any) => v.cambio)).sort()
const anios = unicos(vehiculos.map((v: any) => v.anio)).sort(
  (a: any, b: any) => b - a,
)
---

<Base
  title='Coches de segunda mano en venta en Villanueva de la Serena | GuadiCar'
  description='Catálogo de coches de segunda mano, ocasión y Km0 en Villanueva de la Serena (Badajoz). Filtra por marca, tipo, precio y kilómetros. Todos revisados, con garantía mínima de 1 año y financiación.'
>
  <header class='cat-hero'>
    <span class='tag' style='color:var(--red);'>Nuestro stock</span>
    <h1>Coches de segunda mano, ocasión y Km0</h1>
    <p>
      Coches revisados y certificados, listos para entregar. Usa los filtros
      para encontrar el tuyo.
    </p>
  </header>

  <section class='section section--gray catalogo'>
    <div class='cat-layout'>
      <button id='abrir-filtros' class='filtros-toggle' type='button'>
        <svg
          width='18'
          height='18'
          viewBox='0 0 24 24'
          fill='none'
          stroke='currentColor'
          stroke-width='2'
          stroke-linecap='round'
          ><line x1='4' y1='6' x2='20' y2='6'></line><line
            x1='7'
            y1='12'
            x2='17'
            y2='12'></line><line x1='10' y1='18' x2='14' y2='18'></line></svg
        >
        Filtros
      </button>

      <aside id='sidebar' class='cat-sidebar'>
        <div class='sidebar-head'>
          <strong>Filtros</strong>
          <button
            id='cerrar-filtros'
            class='sidebar-x'
            type='button'
            aria-label='Cerrar'>✕</button
          >
        </div>

        <div class='sidebar-body'>
          <div class='filtro-grupo'>
            <label>Buscar</label>
            <input
              id='f-buscar'
              type='search'
              placeholder='Marca o modelo…'
              autocomplete='off'
            />
          </div>
          <div class='filtro-grupo'>
            <label>Marca</label>
            <select id='f-marca'
              ><option value=''>Todas</option>{
                marcas.map((m: any) => <option value={m}>{m}</option>)
              }</select
            >
          </div>
          <div class='filtro-grupo'>
            <label>Carrocería</label>
            <select id='f-carroceria'
              ><option value=''>Todas</option>{
                carrocerias.map((x: any) => <option value={x}>{x}</option>)
              }</select
            >
          </div>
          <div class='filtro-grupo'>
            <label>Combustible</label>
            <select id='f-comb'
              ><option value=''>Todos</option>{
                combustibles.map((x: any) => <option value={x}>{x}</option>)
              }</select
            >
          </div>
          <div class='filtro-grupo'>
            <label>Cambio</label>
            <select id='f-cambio'
              ><option value=''>Todos</option>{
                cambios.map((x: any) => <option value={x}>{x}</option>)
              }</select
            >
          </div>
          <div class='filtro-grupo'>
            <label>Estado</label>
            <select id='f-estado'
              ><option value=''>Todos</option><option value='ocasion'
                >Ocasión</option
              ><option value='km0'>Km 0</option><option value='nuevo'
                >Nuevo</option
              ></select
            >
          </div>
          <div class='filtro-grupo'>
            <label>Año desde</label>
            <select id='f-anio'
              ><option value=''>Cualquiera</option>{
                anios.map((a: any) => <option value={a}>{a}</option>)
              }</select
            >
          </div>
          <div class='filtro-grupo filtro-doble'>
            <div>
              <label>Precio mín.</label>
              <select id='f-pmin'
                ><option value=''>—</option><option value='5000'>5.000€</option
                ><option value='10000'>10.000€</option><option value='15000'
                  >15.000€</option
                ><option value='20000'>20.000€</option><option value='25000'
                  >25.000€</option
                ><option value='30000'>30.000€</option></select
              >
            </div>
            <div>
              <label>Precio máx.</label>
              <select id='f-pmax'
                ><option value=''>—</option><option value='10000'
                  >10.000€</option
                ><option value='15000'>15.000€</option><option value='20000'
                  >20.000€</option
                ><option value='25000'>25.000€</option><option value='30000'
                  >30.000€</option
                ><option value='40000'>40.000€</option><option value='50000'
                  >50.000€</option
                ></select
              >
            </div>
          </div>
          <div class='filtro-grupo'>
            <label>Km máximo</label>
            <select id='f-km'
              ><option value=''>Cualquiera</option><option value='25000'
                >25.000 km</option
              ><option value='50000'>50.000 km</option><option value='75000'
                >75.000 km</option
              ><option value='100000'>100.000 km</option><option value='150000'
                >150.000 km</option
              ><option value='200000'>200.000 km</option></select
            >
          </div>
        </div>

        <div class='sidebar-foot'>
          <button id='f-reset' class='f-reset' type='button'
            >Limpiar filtros</button
          >
          <button id='f-aplicar' class='f-aplicar' type='button'
            >Ver <span id='count-btn'>{vehiculos.length}</span> coches</button
          >
        </div>
      </aside>

      <div class='cat-main'>
        <div class='cat-toolbar'>
          <div class='cat-count'>
            <span id='count'>{vehiculos.length}</span> vehículos disponibles
          </div>
          <label class='filter-orden'
            >Ordenar:
            <select id='f-orden'>
              <option value=''>Relevancia</option>
              <option value='precio-asc'>Precio: menor a mayor</option>
              <option value='precio-desc'>Precio: mayor a menor</option>
              <option value='anio-desc'>Año: más nuevo</option>
              <option value='km-asc'>Km: menos kilómetros</option>
            </select>
          </label>
        </div>

        <div class='cars-grid cars-grid--cat' id='grid'>
          {
            vehiculos.map((c: any) => (
              <TarjetaCoche
                c={c}
                data-marca={c.marca}
                data-estado={c.estado}
                data-comb={c.combustible}
                data-cambio={c.cambio}
                data-carroceria={c.carroceria}
                data-precio={c.precioOculto ? undefined : c.precio}
                data-oculto={c.precioOculto ? 'true' : 'false'}
                data-anio={c.anio}
                data-km={c.km}
                data-nombre={`${c.marca} ${c.modelo}`.toLowerCase()}
              />
            ))
          }
        </div>

        <div id='no-results' class='no-results' hidden>
          No hay vehículos que coincidan con tu búsqueda.
        </div>
      </div>
    </div>

    <div id='filtros-backdrop' class='filtros-backdrop' hidden></div>
  </section>

  <style>
    .catalogo {
      padding-top: 2rem;
      padding-left: 1.5rem;
      padding-right: 2rem;
    }
    .cat-layout {
      display: grid;
      grid-template-columns: 260px 1fr;
      gap: 1.8rem;
      align-items: start;
      max-width: 1380px;
      margin: 0 auto;
    }

    /* Barra lateral sticky con cabecera y pie fijos */
    .cat-sidebar {
      position: sticky;
      top: 90px;
      align-self: start;
      display: flex;
      flex-direction: column;
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 16px;
      max-height: calc(100vh - 110px);
      overflow: hidden;
    }
    .sidebar-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.1rem 1.2rem 0.9rem;
      flex: 0 0 auto;
    }
    .sidebar-head strong {
      font-family: var(--font-h);
      font-size: 1.1rem;
      font-weight: 800;
    }
    .sidebar-x {
      display: none;
      background: none;
      border: none;
      font-size: 1.1rem;
      cursor: pointer;
      color: var(--muted);
    }
    .sidebar-body {
      flex: 1 1 auto;
      overflow-y: auto;
      padding: 0.2rem 1.2rem;
      scrollbar-width: thin;
      scrollbar-color: var(--border) transparent;
    }
    .sidebar-body::-webkit-scrollbar {
      width: 4px;
    }
    .sidebar-body::-webkit-scrollbar-thumb {
      background: var(--border);
      border-radius: 4px;
    }

    .filtro-grupo {
      margin-bottom: 0.9rem;
    }
    .filtro-grupo > label {
      display: block;
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      color: var(--muted);
      margin-bottom: 0.35rem;
    }
    .filtro-grupo select,
    .filtro-grupo input {
      width: 100%;
      padding: 0.6rem 0.7rem;
      border: 1px solid var(--border);
      border-radius: 9px;
      background: #fff;
      font-family: inherit;
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--text);
      cursor: pointer;
    }
    .filtro-grupo input {
      cursor: text;
    }
    .filtro-grupo select:focus,
    .filtro-grupo input:focus {
      outline: none;
      border-color: var(--red);
    }
    .filtro-doble {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.6rem;
    }
    .filtro-doble label {
      font-size: 0.68rem;
    }

    .sidebar-foot {
      flex: 0 0 auto;
      padding: 0.9rem 1.2rem 1.1rem;
      border-top: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      background: #fff;
    }
    .f-reset {
      padding: 0.6rem;
      border: 1px solid var(--border);
      border-radius: 9px;
      background: #fff;
      font-family: inherit;
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--text);
      cursor: pointer;
    }
    .f-reset:hover {
      border-color: var(--red);
      color: var(--red);
    }
    .f-aplicar {
      padding: 0.8rem;
      border: none;
      border-radius: 9px;
      background: var(--red);
      color: #fff;
      font-family: inherit;
      font-size: 0.92rem;
      font-weight: 800;
      cursor: pointer;
    }
    .f-aplicar:hover {
      filter: brightness(1.08);
    }

    .cat-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.6rem;
      margin-bottom: 1.4rem;
    }
    .cat-count {
      font-size: 0.85rem;
      color: var(--muted);
    }
    .cat-count #count {
      color: var(--red);
      font-weight: 800;
    }
    .filter-orden {
      font-size: 0.82rem;
      color: var(--muted);
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .filter-orden select {
      padding: 0.5rem 0.7rem;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: #fff;
      font-family: inherit;
      font-size: 0.82rem;
      font-weight: 600;
      color: var(--text);
      cursor: pointer;
    }

    .cars-grid--cat {
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    }
    .car-card {
      text-decoration: none;
      color: inherit;
      display: block;
    }
    .car-card.hide {
      display: none;
    }
    .no-results {
      text-align: center;
      color: var(--muted);
      padding: 3rem 0;
      font-weight: 600;
    }

    .filtros-toggle {
      display: none;
      align-items: center;
      gap: 0.5rem;
      padding: 0.7rem 1.2rem;
      border: none;
      border-radius: 10px;
      background: var(--text);
      color: #fff;
      font-family: inherit;
      font-size: 0.9rem;
      font-weight: 700;
      cursor: pointer;
      margin: 0 auto 1.4rem;
    }
    .filtros-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
      z-index: 1500;
    }
    .filtros-backdrop[hidden] {
      display: none;
    }

    /* ===== Móvil: panel deslizante ===== */
    @media (max-width: 880px) {
      .cat-layout {
        display: block;
      }
      .filtros-toggle {
        display: flex;
        width: 100%;
        justify-content: center;
      }
      .cat-sidebar {
        position: fixed;
        top: 0;
        left: 0;
        bottom: 0;
        z-index: 1600;
        width: 86%;
        max-width: 340px;
        height: 100%;
        max-height: none;
        border-radius: 0;
        border: none;
        transform: translateX(-100%);
        transition: transform 0.28s ease;
        box-shadow: 0 0 40px rgba(0, 0, 0, 0.25);
      }
      .cat-sidebar.abierto {
        transform: translateX(0);
      }
      .sidebar-x {
        display: block;
      }
      .sidebar-head {
        padding: 1.2rem;
        border-bottom: 1px solid var(--border);
      }
    }
  </style>

  <script>
    // @ts-nocheck
    const $ = (id) => document.getElementById(id)
    const grid = $('grid')
    const todas = [...grid.querySelectorAll('.car-card')]
    const orig = [...todas]
    const val = (id) => {
      const el = $(id)
      return el ? el.value : ''
    }
    const txt = (s) => (s || '').toString().trim().toLowerCase()

    const IDS = [
      'f-buscar',
      'f-marca',
      'f-carroceria',
      'f-comb',
      'f-cambio',
      'f-estado',
      'f-anio',
      'f-pmin',
      'f-pmax',
      'f-km',
    ]

    function coincide(c) {
      const d = c.dataset
      const q = txt(val('f-buscar'))
      const marca = txt(val('f-marca'))
      const carro = txt(val('f-carroceria'))
      const comb = txt(val('f-comb'))
      const cambio = txt(val('f-cambio'))
      const estado = txt(val('f-estado'))
      const anio = Number(val('f-anio') || 0)
      const pmin = Number(val('f-pmin') || 0)
      const pmax = Number(val('f-pmax') || Infinity)
      const kmax = Number(val('f-km') || Infinity)
      const ocultoPrecio = d.oculto === 'true'
      const filtraPrecio = val('f-pmin') !== '' || val('f-pmax') !== ''
      if (ocultoPrecio && filtraPrecio) return false
      return (
        (!q || txt(d.nombre).includes(q)) &&
        (!marca || txt(d.marca) === marca) &&
        (!carro || txt(d.carroceria) === carro) &&
        (!comb || txt(d.comb) === comb) &&
        (!cambio || txt(d.cambio) === cambio) &&
        (!estado || txt(d.estado) === estado) &&
        (Number(d.anio) || 0) >= anio &&
        (Number(d.precio) || 0) >= pmin &&
        (Number(d.precio) || 0) <= pmax &&
        (Number(d.km) || 0) <= kmax
      )
    }

    function aplicarOrden() {
      const modo = val('f-orden')
      const num = (c, k) => Number(c.dataset[k]) || 0
      let arr = [...orig]
      const oculto = (c) => (c.dataset.oculto === 'true' ? 1 : 0)
      if (modo === 'precio-asc')
        arr.sort(
          (a, b) =>
            oculto(a) - oculto(b) || num(a, 'precio') - num(b, 'precio'),
        )
      else if (modo === 'precio-desc')
        arr.sort(
          (a, b) =>
            oculto(a) - oculto(b) || num(b, 'precio') - num(a, 'precio'),
        )
      else if (modo === 'anio-desc')
        arr.sort((a, b) => num(b, 'anio') - num(a, 'anio'))
      else if (modo === 'km-asc')
        arr.sort((a, b) => num(a, 'km') - num(b, 'km'))
      arr.forEach((c) => grid.appendChild(c))
    }

    // Solo cuenta y actualiza el botón (NO toca el grid)
    function previa() {
      const n = todas.filter(coincide).length
      const cb = $('count-btn')
      if (cb) cb.textContent = String(n)
    }

    // Aplica de verdad al grid
    function aplicar() {
      let visibles = 0
      todas.forEach((c) => {
        const ok = coincide(c)
        c.classList.toggle('hide', !ok)
        if (ok) visibles++
      })
      const count = $('count')
      if (count) count.textContent = String(visibles)
      const noRes = $('no-results')
      if (noRes) noRes.hidden = visibles > 0
      aplicarOrden()
      guardarEnURL()
    }

    // Filtros en la dirección (?marca=Audi&pmax=15000…): se pueden compartir,
    // el botón Atrás los conserva y la home enlaza al catálogo ya filtrado
    const PARAMS = {
      'f-buscar': 'q',
      'f-marca': 'marca',
      'f-carroceria': 'carroceria',
      'f-comb': 'combustible',
      'f-cambio': 'cambio',
      'f-estado': 'estado',
      'f-anio': 'desde',
      'f-pmin': 'pmin',
      'f-pmax': 'pmax',
      'f-km': 'km',
      'f-orden': 'orden',
    }
    function guardarEnURL() {
      const q = new URLSearchParams()
      for (const [id, nombre] of Object.entries(PARAMS)) {
        const v = val(id).trim()
        if (v) q.set(nombre, v)
      }
      const texto = q.toString()
      history.replaceState(null, '', texto ? `?${texto}` : location.pathname)
    }
    function leerDeURL() {
      const q = new URLSearchParams(location.search)
      let alguno = false
      for (const [id, nombre] of Object.entries(PARAMS)) {
        const v = q.get(nombre)
        const el = $(id)
        if (v && el) {
          el.value = v
          alguno = true
        }
      }
      return alguno
    }

    // Panel móvil
    const sidebar = $('sidebar')
    const backdrop = $('filtros-backdrop')
    const abrir = () => {
      sidebar?.classList.add('abierto')
      if (backdrop) backdrop.hidden = false
      document.body.style.overflow = 'hidden'
    }
    const cerrar = () => {
      sidebar?.classList.remove('abierto')
      if (backdrop) backdrop.hidden = true
      document.body.style.overflow = ''
    }
    $('abrir-filtros')?.addEventListener('click', abrir)
    $('cerrar-filtros')?.addEventListener('click', cerrar)
    backdrop?.addEventListener('click', cerrar)

    // Cambiar filtros = solo vista previa en el botón
    IDS.forEach((id) => {
      const ev = id === 'f-buscar' ? 'input' : 'change'
      $(id)?.addEventListener(ev, previa)
    })
    // Orden = se aplica al momento sobre lo visible
    $('f-orden')?.addEventListener('change', () => {
      aplicarOrden()
      guardarEnURL()
    })
    // Botón "Ver N coches" = aplica filtros y cierra panel en móvil
    $('f-aplicar')?.addEventListener('click', () => {
      aplicar()
      cerrar()
    })
    // Limpiar = resetea y muestra todo
    $('f-reset')?.addEventListener('click', () => {
      ;[...IDS, 'f-orden'].forEach((id) => {
        const el = $(id)
        if (el) el.value = ''
      })
      aplicar()
      previa()
    })

    if (leerDeURL()) aplicar()
    previa()
  </script>
</Base>
