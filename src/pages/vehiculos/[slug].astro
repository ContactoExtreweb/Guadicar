  <script>
    // @ts-nocheck
    document.querySelectorAll('[data-galeria]').forEach((g) => {
      const imgs = [...g.querySelectorAll('.fg-img')]
      if (imgs.length === 0) return
      const main = g.querySelector('.fg-main')
      if (!main) return
      const puntos = [...g.querySelectorAll('.fg-punto')]
      const thumbs = [...g.querySelectorAll('.fg-thumb')]
      const contador = g.querySelector('[data-actual]')
      let actual = 0

      const lb = g.querySelector('[data-lightbox]')
      const lbImg = lb && lb.querySelector('.flb-img')
      const lbCont = lb && lb.querySelector('[data-flb-actual]')

      function mostrar(i) {
        actual = (i + imgs.length) % imgs.length
        imgs.forEach((img, n) => img.classList.toggle('activa', n === actual))
        puntos.forEach((p, n) => p.classList.toggle('activa', n === actual))
        thumbs.forEach((t, n) => t.classList.toggle('activa', n === actual))
        if (contador) contador.textContent = String(actual + 1)
        thumbs[actual]?.scrollIntoView({
          inline: 'center',
          block: 'nearest',
          behavior: 'smooth',
        })
        if (lb && !lb.hidden && lbImg) {
          lbImg.src = imgs[actual].src
          if (lbCont) lbCont.textContent = String(actual + 1)
        }
      }

      thumbs.forEach((t, n) => t.addEventListener('click', () => mostrar(n)))
      puntos.forEach((p, n) => p.addEventListener('click', () => mostrar(n)))
      g.querySelector('.fg-prev')?.addEventListener('click', () =>
        mostrar(actual - 1),
      )
      g.querySelector('.fg-next')?.addEventListener('click', () =>
        mostrar(actual + 1),
      )

      // Swipe en la foto principal (cambiar foto)
      let x0 = null
      main.addEventListener(
        'touchstart',
        (e) => {
          x0 = e.touches[0].clientX
        },
        { passive: true },
      )
      main.addEventListener(
        'touchend',
        (e) => {
          if (x0 === null) return
          const dx = e.changedTouches[0].clientX - x0
          if (Math.abs(dx) > 40) mostrar(actual + (dx < 0 ? 1 : -1))
          x0 = null
        },
        { passive: true },
      )

      // Lightbox
      function abrirLB() {
        if (!lb) return
        if (lbImg) lbImg.src = imgs[actual].src
        if (lbCont) lbCont.textContent = String(actual + 1)
        lb.hidden = false
        document.body.style.overflow = 'hidden'
      }
      function cerrarLB() {
        if (lb) {
          lb.hidden = true
          document.body.style.overflow = ''
        }
      }

      // Al pulsar la foto (ignora flechas, puntos y contador)
      main.addEventListener('click', (e) => {
        if (e.target.closest('.fg-flecha, .fg-puntos, .fg-contador')) return
        abrirLB()
      })

      if (lb) {
        lb.querySelector('.flb-cerrar')?.addEventListener('click', cerrarLB)
        lb.querySelector('.flb-prev')?.addEventListener('click', () =>
          mostrar(actual - 1),
        )
        lb.querySelector('.flb-next')?.addEventListener('click', () =>
          mostrar(actual + 1),
        )
        lb.addEventListener('click', (e) => {
          if (e.target === lb) cerrarLB()
        }) // clic fuera de la imagen
        document.addEventListener('keydown', (e) => {
          if (lb.hidden) return
          if (e.key === 'Escape') cerrarLB()
          else if (e.key === 'ArrowLeft') mostrar(actual - 1)
          else if (e.key === 'ArrowRight') mostrar(actual + 1)
        })
        let lx0 = null
        lb.addEventListener(
          'touchstart',
          (e) => {
            lx0 = e.touches[0].clientX
          },
          { passive: true },
        )
        lb.addEventListener(
          'touchend',
          (e) => {
            if (lx0 === null) return
            const dx = e.changedTouches[0].clientX - lx0
            if (Math.abs(dx) > 40) mostrar(actual + (dx < 0 ? 1 : -1))
            lx0 = null
          },
          { passive: true },
        )
      }
    })
  </script>

  <script>
    import { supabase } from '../../lib/supabaseBrowser.js'

    const el = document.querySelector('[data-vehiculo-id]')
    const id = el?.getAttribute('data-vehiculo-id')

    if (id) {
      ;(async () => {
        const { data } = await supabase.auth.getSession()
        if (data.session) return // eres tú (admin): no contamos la visita

        const clave = 'vista_' + id
        if (sessionStorage.getItem(clave)) return
        sessionStorage.setItem(clave, '1')

        const { error } = await supabase
          .from('vistas')
          .insert({ vehiculo_id: id })
        if (error) console.warn('No se pudo registrar la vista:', error.message)
      })()
    }
  </script>
</Base>
