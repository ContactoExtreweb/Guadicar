---
export const prerender = false
import Base from '../../layouts/Base.astro'
import { getVehiculo, badgeDe, fmt } from '../../lib/coches.js'
import Calculadora from '../../components/Calculadora.astro'

const { slug } = Astro.params
const v = await getVehiculo(slug)

// Si el coche no existe (o se vendió y se despublicó), 404 limpio
if (!v) return Astro.redirect('/404')

const titulo = `${v.marca} ${v.modelo} ${v.version ?? ''} de ${v.estado === 'km0' ? 'Km0' : 'ocasión'} | GuadiCar`
const desc = `${v.marca} ${v.modelo} ${v.anio}, ${fmt(v.km)} km, ${v.combustible}. ${fmt(v.precio)}€ o desde ${v.cuota}€/mes. Vehículo revisado y certificado en Villanueva de la Serena (Badajoz).`

// Datos estructurados del coche para Google (rich results)
const schemaCoche = {
  '@context': 'https://schema.org',
  '@type': 'Car',
  name: `${v.marca} ${v.modelo} ${v.version ?? ''}`.trim(),
  description: desc,
  brand: { '@type': 'Brand', name: v.marca },
  model: v.modelo,
  vehicleModelDate: String(v.anio),
  productionDate: String(v.anio),
  ...(v.matriculacion && { dateVehicleFirstRegistered: v.matriculacion }),
  mileageFromOdometer: {
    '@type': 'QuantitativeValue',
    value: v.km,
    unitCode: 'KMT',
  },
  fuelType: v.combustible,
  vehicleTransmission: v.cambio,
  ...(v.carroceria && { bodyType: v.carroceria }),
  ...(v.puertas && { numberOfDoors: v.puertas }),
  ...(v.plazas && {
    vehicleSeatingCapacity: v.plazas,
  }),
  ...(v.potencia && {
    vehicleEngine: {
      '@type': 'EngineSpecification',
      enginePower: {
        '@type': 'QuantitativeValue',
        value: v.potencia,
        unitCode: 'N12', // CV
      },
    },
  }),
  ...(v.traccion && { driveWheelConfiguration: v.traccion }),
  image: v.fotos,
  itemCondition: 'https://schema.org/UsedCondition',
  offers: {
    '@type': 'Offer',
    price: v.precio,
    priceCurrency: 'EUR',
    availability: v.reservado
      ? 'https://schema.org/OutOfStock'
      : 'https://schema.org/InStock',
    itemCondition: 'https://schema.org/UsedCondition',
    url: `https://guadicar.es/vehiculos/${v.slug}`,
    seller: {
      '@type': 'AutoDealer',
      name: 'GuadiCar Multimarcas',
      telephone: '+34722496124',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Polígono Cagancha, 39',
        addressLocality: 'Villanueva de la Serena',
        addressRegion: 'Badajoz',
        postalCode: '06700',
        addressCountry: 'ES',
      },
    },
  },
}

const schemaBreadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Inicio',
      item: 'https://guadicar.es/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Vehículos',
      item: 'https://guadicar.es/vehiculos',
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: `${v.marca} ${v.modelo}`,
      item: `https://guadicar.es/vehiculos/${v.slug}`,
    },
  ],
}

const ic = {
  matricula: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="10" rx="2"/><path d="M8 10v4M12 10v4M16 10v4"/></svg>`,
  km: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 18a8 8 0 1 1 16 0"/><path d="M12 18l4-5"/><circle cx="12" cy="18" r="1.2" fill="currentColor" stroke="none"/></svg>`,
  combustible: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 21V5a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v16"/><path d="M4 21h12M9 9h4"/><path d="M16 8l2.5 2.5V17a1.5 1.5 0 0 0 3 0V9l-2.5-2.5"/></svg>`,
  transmision: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M18.4 5.6L17 7M7 17l-1.4 1.4"/></svg>`,
  potencia: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M13 3 5 13h6l-1 8 8-11h-6z"/></svg>`,
  traccion: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="12" r="3"/><circle cx="18" cy="12" r="3"/><path d="M9 12h6"/></svg>`,
  puertas: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="3" width="12" height="18" rx="1"/><path d="M9 21V3"/><circle cx="14.5" cy="12" r="1" fill="currentColor" stroke="none"/></svg>`,
  plazas: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3"/><path d="M4 20a5 5 0 0 1 10 0"/><circle cx="17" cy="9" r="2.2"/><path d="M15.5 20a4 4 0 0 1 5.5-3.2"/></svg>`,
  anio: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 9h18M8 3v4M16 3v4"/></svg>`,
  carroceria: `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 13l2-5a2 2 0 0 1 2-1h10a2 2 0 0 1 2 1l2 5"/><path d="M3 13h18v4a1 1 0 0 1-1 1h-1a2 2 0 0 1-4 0H9a2 2 0 0 1-4 0H4a1 1 0 0 1-1-1z"/><circle cx="7.5" cy="16.5" r="1.2" fill="currentColor" stroke="none"/><circle cx="16.5" cy="16.5" r="1.2" fill="currentColor" stroke="none"/></svg>`,
}

const fotos = Array.isArray(v.fotos) ? v.fotos : []
---

<Base title={titulo} description={desc} image={v.fotos[0]}>
  <section class='ficha'>
    <div data-vehiculo-id={v.id}></div>
    <!-- Migas de pan (bueno para SEO y navegación) -->
    <nav class='breadcrumb'>
      <a href='/'>Inicio</a> › <a href='/vehiculos'>Vehículos</a> › <span
        >{v.marca} {v.modelo}</span
      >
    </nav>

    <div class='ficha-grid'>
      <!-- Galería -->
      <div class='ficha-galeria' data-galeria>
        <div class='fg-main'>
          {
            v.fotos.map((f: string, i: number) => (
              <img
                src={f}
                alt={`${v.marca} ${v.modelo} — foto ${i + 1}`}
                class:list={['fg-img', { activa: i === 0 }]}
                loading={i === 0 ? 'eager' : 'lazy'}
              />
            ))
          }
          {
            v.certificado && (
              <div class='car-cert'>✓ Revisado y certificado</div>
            )
          }
          <div class='car-badge'>{badgeDe(v)}</div>
          {
            v.fotos.length > 1 && (
              <button
                class='fg-flecha fg-prev'
                type='button'
                aria-label='Foto anterior'
              >
                ‹
              </button>
            )
          }
          {
            v.fotos.length > 1 && (
              <button
                class='fg-flecha fg-next'
                type='button'
                aria-label='Foto siguiente'
              >
                ›
              </button>
            )
          }
          <div class='fg-contador'>
            <span data-actual>1</span> / {v.fotos.length}
          </div>
          {
            v.fotos.length > 1 && (
              <div class='fg-puntos'>
                {v.fotos.map((_: string, i: number) => (
                  <span class:list={['fg-punto', { activa: i === 0 }]} />
                ))}
              </div>
            )
          }
        </div>
        {
          v.fotos.length > 1 && (
            <div class='fg-thumbs'>
              {v.fotos.map((f: string, i: number) => (
                <img
                  src={f}
                  alt={`Foto ${i + 1}`}
                  class:list={['fg-thumb', { activa: i === 0 }]}
                  loading='lazy'
                />
              ))}
            </div>
          )
        }

        {
          v.fotos.length > 0 && (
            <div class='fg-lightbox' data-lightbox hidden>
              <button class='flb-cerrar' type='button' aria-label='Cerrar'>
                ✕
              </button>
              {v.fotos.length > 1 && (
                <button
                  class='flb-flecha flb-prev'
                  type='button'
                  aria-label='Anterior'
                >
                  ‹
                </button>
              )}
              <img
                class='flb-img'
                src={v.fotos[0]}
                alt={`${v.marca} ${v.modelo}`}
                loading='lazy'
              />
              {v.fotos.length > 1 && (
                <button
                  class='flb-flecha flb-next'
                  type='button'
                  aria-label='Siguiente'
                >
                  ›
                </button>
              )}
              <div class='flb-contador'>
                <span data-flb-actual>1</span> / {v.fotos.length}
              </div>
            </div>
          )
        }
      </div>

      <!-- Datos y precio -->
      <div class='ficha-info'>
        {
          v.reservado && (
            <div class='ficha-reservado-banner'>
              🔒 Este vehículo está <strong>reservado</strong> actualmente.
              Consúltanos por disponibilidad o coches similares.
            </div>
          )
        }
        <div class='car-brand'>{v.marca}</div>
        <h1 class='ficha-title'>{v.modelo} <span>{v.version}</span></h1>

        <div class='ficha-specs'>
          <div class='spec'><span>Año</span><strong>{v.anio}</strong></div>
          <div class='spec'>
            <span>Kilómetros</span><strong>{fmt(v.km)} km</strong>
          </div>
          <div class='spec'>
            <span>Combustible</span><strong>{v.combustible}</strong>
          </div>
          <div class='spec'><span>Cambio</span><strong>{v.cambio}</strong></div>
          <div class='spec'>
            <span>Potencia</span><strong>{v.potencia} CV</strong>
          </div>
          <div class='spec'>
            <span>Carrocería</span><strong>{v.carroceria}</strong>
          </div>
        </div>

        <div class='ficha-precio'>
          <div class='price-main'>
            <span class='price-num'>{fmt(v.precio)}</span><span
              class='price-cur'>€</span
            >
            {
              v.precioAnterior && (
                <span class='price-old'>{fmt(v.precioAnterior)}€</span>
              )
            }
          </div>
          <div class='price-fin'>
            Financiación desde <strong>{v.cuota}€/mes</strong>
          </div>
        </div>

        <Calculadora precio={v.precio} />

        <div class='ficha-ctas'>
          <a href={`/contacto?coche=${v.slug}`} class='hero-btn-main'
            >Me interesa este coche</a
          >
        </div>
      </div>
    </div>

    <!-- Descripción -->
    {
      v.descripcion && (
        <div class='ficha-desc'>
          <img
            src='/logo_dark.png'
            class='ficha-marca'
            alt=''
            aria-hidden='true'
            loading='lazy'
          />
          <h2>Descripción</h2>
          <p>{v.descripcion}</p>
        </div>
      )
    }

    <!-- Equipamiento -->
    {
      v.equipamiento?.length > 0 && (
        <div class='ficha-equip'>
          <img
            src='/logo.png'
            class='ficha-marca'
            alt=''
            aria-hidden='true'
            loading='lazy'
          />
          <h2>Equipamiento</h2>
          <ul>
            {v.equipamiento.map((e: string) => (
              <li>{e}</li>
            ))}
          </ul>
        </div>
      )
    }

    <!-- Ficha técnica visual -->
    <div class='ficha-tecnica'>
      <h2>Datos básicos</h2>

      <!-- Azulejos -->
      <div class='ft-azulejos'>
        {
          v.matriculacion && (
            <div class='ft-azulejo'>
              <>
                <span class='ft-ico' set:html={ic.matricula} />
                <div class='ft-dato'>
                  <>
                    <span>Matriculación</span>
                    <strong>
                      {new Date(v.matriculacion).toLocaleDateString('es-ES')}
                    </strong>
                  </>
                </div>
              </>
            </div>
          )
        }
        <div class='ft-azulejo'>
          <span class='ft-ico' set:html={ic.km} /><div class='ft-dato'>
            <span>Kilometraje</span><strong>{fmt(v.km)} km</strong>
          </div>
        </div>
        <div class='ft-azulejo'>
          <span class='ft-ico' set:html={ic.combustible} /><div class='ft-dato'>
            <span>Combustible</span><strong>{v.combustible}</strong>
          </div>
        </div>
        <div class='ft-azulejo'>
          <span class='ft-ico' set:html={ic.transmision} /><div class='ft-dato'>
            <span>Transmisión</span><strong>{v.cambio}</strong>
          </div>
        </div>
        <div class='ft-azulejo'>
          <span class='ft-ico' set:html={ic.potencia} /><div class='ft-dato'>
            <span>Potencia</span><strong>{v.potencia} CV</strong>
          </div>
        </div>
        {
          v.traccion && (
            <div class='ft-azulejo'>
              <>
                <span class='ft-ico' set:html={ic.traccion} />
                <div class='ft-dato'>
                  <>
                    <span>Tracción</span>
                    <strong>{v.traccion}</strong>
                  </>
                </div>
              </>
            </div>
          )
        }
        {
          v.puertas && (
            <div class='ft-azulejo'>
              <>
                <span class='ft-ico' set:html={ic.puertas} />
                <div class='ft-dato'>
                  <>
                    <span>Puertas</span>
                    <strong>{v.puertas}</strong>
                  </>
                </div>
              </>
            </div>
          )
        }
        {
          v.plazas && (
            <div class='ft-azulejo'>
              <>
                <span class='ft-ico' set:html={ic.plazas} />
                <div class='ft-dato'>
                  <>
                    <span>Plazas</span>
                    <strong>{v.plazas}</strong>
                  </>
                </div>
              </>
            </div>
          )
        }
        {
          v.anio && (
            <div class='ft-azulejo'>
              <>
                <span class='ft-ico' set:html={ic.anio} />
                <div class='ft-dato'>
                  <>
                    <span>Año</span>
                    <strong>{v.anio}</strong>
                  </>
                </div>
              </>
            </div>
          )
        }
        {
          v.carroceria && (
            <div class='ft-azulejo'>
              <>
                <span class='ft-ico' set:html={ic.carroceria} />
                <div class='ft-dato'>
                  <>
                    <span>Carrocería</span>
                    <strong>{v.carroceria}</strong>
                  </>
                </div>
              </>
            </div>
          )
        }
      </div>

      <!-- Dimensiones con siluetas acotadas + capacidades -->
      {
        (v.largoM ||
          v.anchoM ||
          v.altoM ||
          v.pesoKg ||
          v.depositoL ||
          v.maleteroL) && (
          <div class='ft-dimensiones'>
            <div class='ft-diagrama'>
              <svg
                viewBox='0 0 560 205'
                xmlns='http://www.w3.org/2000/svg'
                style='width:100%;height:auto;font-family:var(--font);'
              >
                <defs>
                  <linearGradient id='ftBody' x1='0' y1='0' x2='0' y2='1'>
                    <stop offset='0' stop-color='#2a3450' />
                    <stop offset='1' stop-color='#1b2235' />
                  </linearGradient>
                </defs>

                <g transform='translate(16,10)'>
                  <path
                    d='M14,118 L14,98 C14,89 21,85 33,83 L66,77 C76,57 94,48 116,48 L150,48 C172,48 187,57 199,76 L222,82 C234,84 240,89 240,99 L240,118 Z'
                    fill='url(#ftBody)'
                  />

                  <path d='M 44 118 A 22 22 0 0 1 88 118 Z' fill='#11161f' />
                  <path d='M 168 118 A 22 22 0 0 1 212 118 Z' fill='#11161f' />

                  <path
                    d='M74,76 C82,61 96,55 114,54 L132,54 L132,76 Z'
                    fill='#8fa0c4'
                    opacity='0.55'
                  />
                  <path
                    d='M140,54 L150,54 C168,55 181,61 191,75 L140,76 Z'
                    fill='#8fa0c4'
                    opacity='0.55'
                  />

                  <path
                    d='M 185 70 L 195 70 L 193 76 L 185 76 Z'
                    fill='#1b2235'
                  />

                  <circle cx='66' cy='122' r='17' fill='#161c2b' />
                  <circle cx='66' cy='122' r='10' fill='#8fa0c4' />
                  <circle cx='66' cy='122' r='4' fill='#161c2b' />
                  <circle cx='190' cy='122' r='17' fill='#161c2b' />
                  <circle cx='190' cy='122' r='10' fill='#8fa0c4' />
                  <circle cx='190' cy='122' r='4' fill='#161c2b' />

                  <line
                    x1='14'
                    y1='150'
                    x2='14'
                    y2='166'
                    stroke='var(--red)'
                    stroke-width='1.4'
                  />
                  <line
                    x1='240'
                    y1='150'
                    x2='240'
                    y2='166'
                    stroke='var(--red)'
                    stroke-width='1.4'
                  />
                  <line
                    x1='22'
                    y1='158'
                    x2='232'
                    y2='158'
                    stroke='var(--red)'
                    stroke-width='1.6'
                  />
                  <path d='M14,158 L22,154 L22,162 Z' fill='var(--red)' />
                  <path d='M240,158 L232,154 L232,162 Z' fill='var(--red)' />
                  <rect
                    x='100'
                    y='148'
                    width='54'
                    height='20'
                    rx='5'
                    fill='#ffffff'
                  />
                  <text
                    x='127'
                    y='162.5'
                    text-anchor='middle'
                    font-size='13'
                    font-weight='700'
                    fill='var(--text)'
                  >
                    {v.largoM ?? '—'} m
                  </text>
                </g>

                <g transform='translate(304,10)'>
                  <rect
                    x='2'
                    y='68'
                    width='16'
                    height='10'
                    rx='3'
                    fill='#1b2235'
                  />
                  <rect
                    x='182'
                    y='68'
                    width='16'
                    height='10'
                    rx='3'
                    fill='#1b2235'
                  />

                  <rect
                    x='22'
                    y='112'
                    width='26'
                    height='28'
                    rx='4'
                    fill='#161c2b'
                  />
                  <rect
                    x='152'
                    y='112'
                    width='26'
                    height='28'
                    rx='4'
                    fill='#161c2b'
                  />

                  <path
                    d='M 16 118 L 16 85 Q 16 75 24 75 L 42 75 L 56 52 Q 62 48 70 48 L 130 48 Q 138 48 144 52 L 158 75 L 176 75 Q 184 75 184 85 L 184 118 Z'
                    fill='url(#ftBody)'
                  />

                  <path
                    d='M 48 75 L 60 54 Q 64 51 70 51 L 130 51 Q 136 51 140 54 L 152 75 Z'
                    fill='#8fa0c4'
                    opacity='0.55'
                  />
                  <path
                    d='M 60 54 L 80 54 L 60 75 L 48 75 Z'
                    fill='#ffffff'
                    opacity='0.15'
                  />

                  <rect
                    x='65'
                    y='85'
                    width='70'
                    height='14'
                    rx='4'
                    fill='#11161f'
                  />
                  <path
                    d='M 45 106 L 155 106 L 145 116 L 55 116 Z'
                    fill='#11161f'
                  />

                  <path d='M 20 80 L 55 85 L 55 92 L 20 86 Z' fill='#cfd7e6' />
                  <path
                    d='M 180 80 L 145 85 L 145 92 L 180 86 Z'
                    fill='#cfd7e6'
                  />
                  <circle cx='45' cy='88' r='3' fill='#ffffff' />
                  <circle cx='155' cy='88' r='3' fill='#ffffff' />

                  <line
                    x1='16'
                    y1='150'
                    x2='16'
                    y2='166'
                    stroke='var(--red)'
                    stroke-width='1.4'
                  />
                  <line
                    x1='184'
                    y1='150'
                    x2='184'
                    y2='166'
                    stroke='var(--red)'
                    stroke-width='1.4'
                  />
                  <line
                    x1='24'
                    y1='158'
                    x2='176'
                    y2='158'
                    stroke='var(--red)'
                    stroke-width='1.6'
                  />
                  <path d='M16,158 L24,154 L24,162 Z' fill='var(--red)' />
                  <path d='M184,158 L176,154 L176,162 Z' fill='var(--red)' />
                  <rect
                    x='73'
                    y='148'
                    width='54'
                    height='20'
                    rx='5'
                    fill='#ffffff'
                  />
                  <text
                    x='100'
                    y='162.5'
                    text-anchor='middle'
                    font-size='13'
                    font-weight='700'
                    fill='var(--text)'
                  >
                    {v.anchoM ?? '—'} m
                  </text>

                  <line
                    x1='194'
                    y1='48'
                    x2='210'
                    y2='48'
                    stroke='var(--red)'
                    stroke-width='1.4'
                  />
                  <line
                    x1='194'
                    y1='140'
                    x2='210'
                    y2='140'
                    stroke='var(--red)'
                    stroke-width='1.4'
                  />
                  <line
                    x1='202'
                    y1='56'
                    x2='202'
                    y2='132'
                    stroke='var(--red)'
                    stroke-width='1.6'
                  />
                  <path d='M202,48 L198,56 L206,56 Z' fill='var(--red)' />
                  <path d='M202,140 L198,132 L206,132 Z' fill='var(--red)' />

                  <g transform='rotate(-90 202 94)'>
                    <rect
                      x='175'
                      y='84'
                      width='54'
                      height='20'
                      rx='5'
