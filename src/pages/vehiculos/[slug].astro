---
export const prerender = false
import Base from '../../layouts/Base.astro'
import FichaVehiculo from '../../components/FichaVehiculo.astro'
import NoEncontrado from '../../components/NoEncontrado.astro'
import { getVehiculos } from '../../lib/coches.js'
import { cachearEnCDN } from '../../lib/cache.js'

const { slug } = Astro.params

// Una sola consulta: el coche y los "similares" salen del mismo listado de
// publicados (los no publicados no están, así que dan 404)
// ponytail: con varios cientos de coches, pedir el coche y los similares aparte
const todos = await getVehiculos()
const v = todos.find((c) => c.slug === slug) ?? null

// Similares: misma carrocería y marca suman; cuanto más lejos el precio, menos
const similares = v
  ? todos
      .filter((c) => c.id !== v.id)
      .map((c) => ({
        c,
        puntos:
          (c.carroceria === v.carroceria ? 2 : 0) +
          (c.marca === v.marca ? 1 : 0) -
          (v.precio > 0 && c.precio > 0
            ? Math.abs(c.precio - v.precio) / v.precio
            : 1),
      }))
      .sort((a, b) => b.puntos - a.puntos)
      .slice(0, 4)
      .map((x) => x.c)
  : []

// Si el coche no existe (o se vendió y se despublicó), la misma URL responde
// con el contenido del 404 y estado 404 de verdad. Antes redirigía a /404, que
// responde 200: Google lo tomaba como página válida y no retiraba la URL.
if (!v) Astro.response.status = 404

// También se cachea el 404: si el coche vuelve a publicarse, el panel purga
// la caché y aparece al momento.
cachearEnCDN(Astro.response.headers)
---

{
  v ? (
    <FichaVehiculo v={v} similares={similares} />
  ) : (
    <Base
      title='Vehículo no disponible | GuadiCar'
      description='El vehículo que buscas ya no está disponible.'
      noindex
    >
      <NoEncontrado />
    </Base>
  )
}
