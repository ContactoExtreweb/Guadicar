---
import Base from '../layouts/Base.astro';

const servicios = [
  { n:'01', img:'https://images.unsplash.com/photo-1560472355-536de3962603?auto=format&fit=crop&w=800&q=80',
    titulo:'Compra, venta y tasación', texto:'Tasamos tu vehículo gratis al mejor precio del mercado y lo aplicamos como parte del pago de tu próximo coche.',
    puntos:['Tasación gratuita en 24 horas','Aceptamos cualquier marca y modelo','Pago inmediato al contado'] },
  { n:'02', img:'https://images.unsplash.com/photo-1450101499163-c8848c66ca85?auto=format&fit=crop&w=800&q=80',
    titulo:'Financiación a medida', texto:'Trabajamos con múltiples entidades para ofrecerte la mejor opción. Sin cambiar de banco, con condiciones reales.',
    puntos:['Hasta el 100% del valor','Sin entrada si lo prefieres','De 12 a 84 meses','Respuesta en menos de 2h'] },
  { n:'03', img:'https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=800&q=80',
    titulo:'Garantía extendida', texto:'Todos los vehículos salen con garantía real que cubre lo que tiene que cubrir cuando más lo necesitas.',
    puntos:['Mínimo 1 año en todo el stock','Ampliable hasta 3 años Premium','Cubre averías mecánicas y eléctricas','Asistencia en carretera incluida'] },
  { n:'04', img:'https://images.unsplash.com/photo-1625047509168-a7026f36de04?auto=format&fit=crop&w=800&q=80',
    titulo:'Taller multimarca', texto:'Mecánicos certificados para mantener y reparar cualquier vehículo. Revisiones, ITV y diagnóstico electrónico.',
    puntos:['Revisiones y pre-ITV','Diagnóstico electrónico','Chapa y pintura','Recambios originales y alternativos'] },
];

const proceso = [
  { ico:'🔍', titulo:'Elige tu coche', texto:'Explora el catálogo o visítanos. Te asesoramos sin presión.' },
  { ico:'💬', titulo:'Consulta y prueba', texto:'Reserva una prueba de conducción y resuelve tus dudas.' },
  { ico:'📋', titulo:'Financia y firma', texto:'Cerramos las condiciones y nos encargamos de los trámites.' },
  { ico:'🚗', titulo:'Recibe tu coche', texto:'Entrega en nuestras instalaciones o en tu domicilio.' },
];
---
<Base solidNav={true}
      title="Servicios · GuadiCar Multimarcas en Villanueva de la Serena (Badajoz)"
      description="Compra, venta y tasación, financiación a medida, garantía extendida y taller multimarca. Servicios integrales de GuadiCar en Villanueva de la Serena (Badajoz).">

<header class="cat-hero">
  <span class="tag" style="color:var(--red);">Lo que ofrecemos</span>
  <h1>Servicios <em>integrales</em></h1>
  <p>Más allá de la venta — te acompañamos en cada paso con total transparencia.</p>
</header>

<section class="section section--white">
  <div class="serv-lista">
    {servicios.map((s, i) => (
      <div class={`serv-row ${i % 2 === 1 ? 'serv-row--inv' : ''}`}>
        <div class="serv-img"><img src={s.img} alt={s.titulo} loading="lazy" /><span class="serv-num">{s.n}</span></div>
        <div class="serv-body">
          <h2>{s.titulo}</h2>
          <p>{s.texto}</p>
          <ul>{s.puntos.map(p => <li>{p}</li>)}</ul>
          <a href="/contacto" class="btn-card" style="display:inline-block;width:auto;">Más información</a>
        </div>
      </div>
    ))}
  </div>
</section>

<section class="section section--gray">
  <div class="s-header" style="text-align:center;max-width:580px;margin:0 auto 2.5rem;">
    <span class="tag">Proceso</span>
    <h2 class="s-title">Cómo funciona</h2>
  </div>
  <div class="serv-proceso">
    {proceso.map((p, i) => (
      <div class="serv-paso">
        <span class="sp-num">0{i+1}</span>
        <div class="sp-ico">{p.ico}</div>
        <h3>{p.titulo}</h3>
        <p>{p.texto}</p>
      </div>
    ))}
  </div>
</section>

<div class="cta-strip">
  <div><h2>¿Tienes alguna duda?</h2><p>Respondemos en menos de 24 horas, sin compromiso.</p></div>
  <a href="/contacto" class="btn-white">Contactar ahora</a>
</div>

<style>
  .serv-lista { display:flex; flex-direction:column; gap:3rem; max-width:1050px; margin:0 auto; }
  .serv-row { display:grid; grid-template-columns:1fr 1fr; gap:2.5rem; align-items:center; }
  .serv-img { position:relative; border-radius:var(--radius-lg); overflow:hidden; aspect-ratio:4/3; box-shadow:var(--shadow-lg); }
  .serv-img img { width:100%; height:100%; object-fit:cover; }
  .serv-num { position:absolute; top:14px; left:14px; background:var(--red); color:#fff; font-family:var(--font-h); font-weight:800; font-size:.9rem; padding:.3rem .7rem; border-radius:8px; }
  .serv-row--inv .serv-img { order:2; }
  .serv-body h2 { font-family:var(--font-h); font-size:1.6rem; font-weight:800; letter-spacing:-.5px; margin:0 0 .8rem; }
  .serv-body p { color:var(--muted); line-height:1.7; margin-bottom:1.2rem; }
  .serv-body ul { list-style:none; padding:0; margin:0 0 1.5rem; display:flex; flex-direction:column; gap:.6rem; }
  .serv-body li { padding-left:1.6rem; position:relative; }
  .serv-body li::before { content:'✓'; position:absolute; left:0; color:var(--red); font-weight:800; }
  .serv-proceso { display:grid; grid-template-columns:repeat(4,1fr); gap:1.5rem; max-width:1050px; margin:0 auto; }
  .serv-paso { background:#fff; border:1px solid var(--border); border-radius:14px; padding:1.8rem; text-align:center; }
  .sp-num { font-family:var(--font-h); font-weight:800; color:var(--red); font-size:.9rem; }
  .sp-ico { font-size:2rem; margin:.5rem 0; }
  .serv-paso h3 { font-size:1.05rem; font-weight:800; margin:.3rem 0 .5rem; }
  .serv-paso p { color:var(--muted); font-size:.88rem; line-height:1.6; }
  @media (max-width:820px){
    .serv-row, .serv-row--inv .serv-img { grid-template-columns:1fr; order:0; }
    .serv-proceso { grid-template-columns:1fr 1fr; }
  }
</style>

</Base>