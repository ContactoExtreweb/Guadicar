---
import Base from '../layouts/Base.astro'
---

<Base
  solidNav={true}
  title='Contacto · GuadiCar Multimarcas en Villanueva de la Serena (Badajoz)'
  description='Contacta con GuadiCar Multimarcas en Villanueva de la Serena (Badajoz). Teléfono 722 49 61 24, ventas@guadicar.es. Polígono Cagancha, 39. Lunes a sábado.'
>
  <header class='cat-hero'>
    <span class='tag' style='color:var(--red);'>Estamos aquí para ayudarte</span
    >
    <h1>Contacto</h1>
    <p>
      ¿Tienes una duda o quieres más información sobre un coche? Escríbenos y te
      respondemos enseguida.
    </p>
  </header>

  <section class='section section--gray'>
    <div class='contacto-wrap'>
      <!-- Datos -->
      <div class='contacto-datos'>
        <h2>GuadiCar Multimarcas</h2>
        <ul class='contacto-info'>
          <li>
            <span>📍</span><div>
              <strong>Dirección</strong>Polígono Cagancha, 39<br />06700
              Villanueva de la Serena (Badajoz)
            </div>
          </li>
          <li>
            <span>📞</span><div>
              <strong>Teléfono</strong><a href='tel:+34722496124'
                >📞 722 49 61 24</a
              >
            </div>
          </li>
          <li>
            <span>✉️</span><div>
              <strong>Email</strong><a href='mailto:ventas@guadicar.es'
                >ventas@guadicar.es</a
              >
            </div>
          </li>
          <li>
            <span>🕒</span><div>
              <strong>Horario</strong>Lunes a Viernes: 10:00–14:00 y 17:00–21:00<br
              />Sábados: 10:00–13:00<br />Domingos: Cerrado
            </div>
          </li>
        </ul>
        <a
          href='https://wa.me/34722496124'
          target='_blank'
          rel='noopener'
          class='contacto-wa'
        >
          Escríbenos por WhatsApp
        </a>
      </div>

      <!-- Formulario -->
      <div class='contacto-form-box'>
        <h2>Envíanos un mensaje</h2>
        <form id='form-contacto' class='contacto-form'>
          <div id='coche-interes' class='coche-interes' hidden>
            Consultas sobre: <strong id='coche-nombre'></strong>
          </div>
          <label>Nombre *<input name='nombre' required /></label>
          <div class='cf-row'>
            <label
              >Teléfono *<input name='telefono' type='tel' required /></label
            >
            <label>Email<input name='email' type='email' /></label>
          </div>
          <label
            >Mensaje<textarea
              name='mensaje'
              rows='4'
              placeholder='¿En qué podemos ayudarte?'></textarea></label
          >
          <label class='cf-check'
            ><input type='checkbox' required /> He leído y acepto la política de privacidad</label
          >
          <button type='submit' id='cf-btn'>Enviar mensaje</button>
          <p id='cf-msg' class='cf-msg' hidden></p>
        </form>
      </div>
    </div>

    <!-- Mapa -->
    <div class='contacto-mapa'>
      <div
        data-cookie-embed
        data-src='https://www.google.com/maps?q=Pol%C3%ADgono+Cagancha+39+Villanueva+de+la+Serena+Badajoz&output=embed'
        data-title='Ubicación de GuadiCar'
        data-height='380'
      >
      </div>
    </div>
  </section>

  <style>
    .cat-hero p {
      margin-left: auto;
      margin-right: auto;
    }
    .contacto-wrap {
      display: grid;
      grid-template-columns: 1fr 1.3fr;
      gap: 2rem;
      max-width: 1100px;
      margin: 0 auto;
    }
    .contacto-datos,
    .contacto-form-box {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 2rem;
    }
    .contacto-datos h2,
    .contacto-form-box h2 {
      font-family: var(--font-h);
      font-size: 1.4rem;
      font-weight: 800;
      margin: 0 0 1.5rem;
    }
    .contacto-info {
      list-style: none;
      padding: 0;
      margin: 0 0 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 1.2rem;
    }
    .contacto-info li {
      display: flex;
      gap: 0.9rem;
      align-items: flex-start;
    }
    .contacto-info span {
      font-size: 1.3rem;
    }
    .contacto-info strong {
      display: block;
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--muted);
      margin-bottom: 0.2rem;
    }
    .contacto-info a {
      color: var(--red);
      text-decoration: none;
      font-weight: 700;
    }
    .contacto-wa {
      display: inline-block;
      background: #25d366;
      color: #fff;
      text-decoration: none;
      font-weight: 700;
      padding: 0.8rem 1.3rem;
      border-radius: 10px;
      font-size: 0.9rem;
    }
    .contacto-form {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .contacto-form label {
      display: flex;
      flex-direction: column;
      font-size: 0.8rem;
      font-weight: 700;
      gap: 0.4rem;
    }
    .contacto-form input,
    .contacto-form textarea {
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 0.75rem 0.9rem;
      font-family: inherit;
      font-size: 0.95rem;
    }
    .contacto-form input:focus,
    .contacto-form textarea:focus {
      outline: none;
      border-color: var(--red);
    }
    .cf-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }
    .cf-check {
      flex-direction: row !important;
      align-items: center;
      gap: 0.5rem !important;
      font-weight: 500 !important;
      font-size: 0.82rem;
    }
    .cf-check input {
      width: auto;
    }
    .contacto-form button {
      background: var(--red);
      color: #fff;
      border: none;
      border-radius: 10px;
      padding: 0.9rem;
      font-family: inherit;
      font-size: 0.95rem;
      font-weight: 700;
      cursor: pointer;
    }
    .contacto-form button:disabled {
      opacity: 0.6;
    }
    .coche-interes {
      background: var(--gray);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 0.8rem 1rem;
      font-size: 0.85rem;
    }
    .cf-msg {
      padding: 0.8rem;
      border-radius: 9px;
      text-align: center;
      font-weight: 600;
      font-size: 0.88rem;
    }
    .cf-msg.ok {
      background: #dcfce7;
      color: #0a7d33;
    }
    .cf-msg.error {
      background: #fee2e2;
      color: #b91c1c;
    }
    .contacto-mapa {
      max-width: 1100px;
      margin: 2rem auto 0;
      border-radius: 16px;
      overflow: hidden;
      border: 1px solid var(--border);
    }
    @media (max-width: 820px) {
      .contacto-wrap {
        grid-template-columns: 1fr;
      }
      .cf-row {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <script>
    // @ts-nocheck
    // Si llega desde una ficha (?coche=...), lo mostramos y lo mandamos en el lead
    const params = new URLSearchParams(window.location.search)
    const coche = params.get('coche')
    if (coche) {
      const nombre = coche
        .replace(/-/g, ' ')
        .replace(/\b\w/g, (c) => c.toUpperCase())
      document.getElementById('coche-interes').hidden = false
      document.getElementById('coche-nombre').textContent = nombre
    }

    const form = document.getElementById('form-contacto')
    const btn = document.getElementById('cf-btn')
    const msg = document.getElementById('cf-msg')

    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      btn.disabled = true
      btn.textContent = 'Enviando…'
      msg.hidden = true

      const payload = {
        nombre: form.nombre.value,
        telefono: form.telefono.value,
        email: form.email.value,
        mensaje: form.mensaje.value,
        vehiculo_nombre: coche
          ? document.getElementById('coche-nombre').textContent
          : null,
      }

      try {
        const res = await fetch('/api/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        })
        if (!res.ok) throw new Error()
        msg.className = 'cf-msg ok'
        msg.textContent = '¡Mensaje enviado! Te contactaremos lo antes posible.'
        msg.hidden = false
        form.reset()
        document.getElementById('coche-interes').hidden = true
      } catch {
        msg.className = 'cf-msg error'
        msg.textContent =
          'Hubo un problema al enviar. Llámanos al 722 49 61 24 o inténtalo de nuevo.'
        msg.hidden = false
      } finally {
        btn.disabled = false
        btn.textContent = 'Enviar mensaje'
      }
    })
  </script>
</Base>
