---
export const prerender = false;
import Admin from '../../../layouts/Admin.astro';
import AdminNav from '../../../components/AdminNav.astro';
import FormVehiculo from '../../../components/FormVehiculo.astro';

// Los datos NO se cargan aquí: esta página se genera en el servidor, que no
// tiene la sesión del panel. Con la clave pública solo se ven los coches
// publicados, así que los ocultos no se podían editar y los datos privados
// salían vacíos. Ahora los carga el navegador con la sesión del admin
// (ver FormVehiculo.astro).
const { slug } = Astro.params;
---
<Admin title="Editar vehículo · GuadiCar">
  <div id="gate" class="admin-gate">Comprobando acceso…</div>
  <div id="panel" hidden>
    <AdminNav activo="vehiculos" />
    <main class="admin-main">
      <h1 class="fv-title" id="fv-titulo">Editar vehículo</h1>
      <FormVehiculo slug={slug} />
    </main>
  </div>
  <script>
    // @ts-nocheck
    import { supabase } from '../../../lib/supabaseBrowser.js';
    (async () => {
      const { data } = await supabase.auth.getSession();
      if (!data.session) { window.location.href = '/admin/login'; return; }
      document.getElementById('gate').hidden = true;
      document.getElementById('panel').hidden = false;
    })();
  </script>
</Admin>
