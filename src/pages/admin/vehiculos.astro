---
import Admin from '../../layouts/Admin.astro'
import AdminNav from '../../components/AdminNav.astro'
---

<Admin title='Vehículos · GuadiCar'>
  <div id='gate' class='admin-gate'>Comprobando acceso…</div>

  <div id='panel' hidden>
    <AdminNav activo='vehiculos' />
    <main class='admin-main'>
      <div class='admin-titlebar'>
        <h1>Vehículos <span id='total' class='admin-total'></span></h1>
      </div>

      <div class='admin-filtros'>
        <input
          type='search'
          id='buscar'
          placeholder='Buscar por marca o modelo…'
        />
        <select id='f-marca'><option value=''>Todas las marcas</option></select>
        <select id='f-comb'>
          <option value=''>Combustible</option>
          <option>Gasolina</option><option>Diésel</option><option
            >Híbrido</option
          ><option>Eléctrico</option>
        </select>
        <select id='f-estado-coche'>
          <option value=''>Estado</option>
          <option value='ocasion'>Ocasión</option><option value='km0'
            >Km 0</option
          ><option value='nuevo'>Nuevo</option>
        </select>
        <select id='f-pub'>
          <option value=''>Publicación</option>
          <option value='pub'>Publicados</option><option value='oculto'
            >Ocultos</option
          >
        </select>
        <select id='f-orden'>
          <option value='reciente'>Más recientes</option>
          <option value='precio-asc'>Precio ↑</option>
          <option value='precio-desc'>Precio ↓</option>
          <option value='km-asc'>Menos km</option>
        </select>
      </div>

      <p id='cargando' class='admin-msg'>Cargando vehículos…</p>
      <div id='lista' class='admin-lista'></div>
      <p id='vacio' class='admin-msg' hidden>No hay vehículos que coincidan.</p>
    </main>
  </div>

  <div id='aviso-modal' class='av-modal' hidden>
    <div class='av-card'>
      <h2>Avisar a los suscriptores</h2>
      <p class='av-coche' id='av-nombre'></p>
      <p class='av-nota' id='av-nota' hidden></p>
      <div class='av-ops'>
        <button type='button' class='av-op' data-tipo='nuevo'>
          🚗 Es una novedad
          <small>«Nuevo en GuadiCar»</small>
        </button>
        <button type='button' class='av-op' data-tipo='bajada' id='av-bajada'>
          📉 Ha bajado de precio
          <small id='av-bajada-info'></small>
        </button>
      </div>
      <button type='button' class='av-cancelar' id='av-cancelar'>Cancelar</button>
    </div>
  </div>

  <style>
    .av-modal {
      position: fixed;
      inset: 0;
      z-index: 120;
      background: rgba(0, 0, 0, 0.5);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.2rem;
    }
    .av-modal[hidden] {
      display: none;
    }
    .av-card {
      background: #fff;
      border-radius: 16px;
      padding: 1.6rem;
      width: 100%;
      max-width: 420px;
      box-shadow: var(--shadow-lg);
    }
    .av-card h2 {
      font-family: var(--font-h);
      font-size: 1.15rem;
      font-weight: 800;
      margin: 0;
    }
    .av-coche {
      font-weight: 700;
      margin: 0.3rem 0 1rem;
    }
    .av-nota {
      background: #fef3c7;
      color: #92400e;
      font-size: 0.82rem;
      font-weight: 600;
      border-radius: 9px;
      padding: 0.7rem 0.8rem;
      margin: 0 0 1rem;
    }
    .av-ops {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }
    .av-op {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
      text-align: left;
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 11px;
      padding: 0.9rem 1rem;
      font-family: inherit;
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--text);
      cursor: pointer;
    }
    .av-op small {
      font-size: 0.78rem;
      font-weight: 500;
      color: var(--muted);
    }
    .av-op:hover:not(:disabled) {
      border-color: var(--red);
    }
    .av-op:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
    .av-cancelar {
      width: 100%;
      margin-top: 1rem;
      background: none;
      border: none;
      font-family: inherit;
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--muted);
      cursor: pointer;
      padding: 0.6rem;
    }
  </style>

  <script>
    // @ts-nocheck
    import { supabase } from '../../lib/supabaseBrowser.js'

    const fmt = (n) => Number(n).toLocaleString('es-ES')
    let TODOS = []

    function render(filtrados) {
      const lista = document.getElementById('lista')
      const vacio = document.getElementById('vacio')
      document.getElementById('total').textContent = `(${filtrados.length})`
      vacio.hidden = filtrados.length > 0

      lista.innerHTML = filtrados
        .map(
          (v) => `
        <div class="admin-row" data-id="${v.id}">
          <img src="${v.fotos?.[0] ?? ''}" alt="" />
          <div class="ar-info">
            <div class="ar-marca">${v.marca}</div>
            <div class="ar-modelo">${v.modelo} <span class="ar-estado ${v.publicado ? 'on' : 'off'}">${v.publicado ? 'Publicado' : 'Oculto'}</span></div>
            <div class="ar-meta">${v.anio ?? ''} · ${fmt(v.km ?? 0)} km</div>
          </div>
          <div class="ar-precio">${v.precio_oculto || v.reservado ? `<span class="ar-precio-oculto">🙈 Oculto${v.reservado && !v.precio_oculto ? ' (reservado)' : ''}</span>` : fmt(v.precio) + ' €'}</div>
          <div class="ar-actions">
            <a class="ar-btn edit" href="/admin/editar/${v.slug}">Editar</a>
            <button class="ar-btn ${v.publicado ? 'unpub' : 'pub'}" data-accion="toggle" data-pub="${v.publicado}">${v.publicado ? 'Ocultar' : 'Publicar'}</button>
            <button class="ar-btn" data-accion="precio" data-oculto="${v.precio_oculto}" title="${v.reservado ? 'Está reservado: el precio ya se oculta solo' : ''}">${v.precio_oculto ? '💶 Mostrar precio' : '🙈 Ocultar precio'}</button>
            <button class="ar-btn del" data-accion="borrar" data-nombre="${v.marca} ${v.modelo}">Borrar</button>
            <button class="ar-btn avisar" data-accion="avisar" data-id="${v.id}" data-nombre="${v.marca} ${v.modelo}">📣 Avisar</button>
          </div>
        </div>`,
        )
        .join('')

      lista
        .querySelectorAll('[data-accion]')
        .forEach((b) => b.addEventListener('click', onAccion))
    }

    function aplicarFiltros() {
      const q = document.getElementById('buscar').value.toLowerCase().trim()
      const marca = document.getElementById('f-marca').value
      const comb = document.getElementById('f-comb').value
      const est = document.getElementById('f-estado-coche').value
      const pub = document.getElementById('f-pub').value
      const orden = document.getElementById('f-orden').value

      let r = TODOS.slice()
      if (q)
        r = r.filter((v) => `${v.marca} ${v.modelo}`.toLowerCase().includes(q))
      if (marca) r = r.filter((v) => v.marca === marca)
      if (comb) r = r.filter((v) => v.combustible === comb)
      if (est) r = r.filter((v) => v.estado === est)
      if (pub === 'pub') r = r.filter((v) => v.publicado)
      if (pub === 'oculto') r = r.filter((v) => !v.publicado)

      if (orden === 'precio-asc') r.sort((a, b) => a.precio - b.precio)
      else if (orden === 'precio-desc') r.sort((a, b) => b.precio - a.precio)
      else if (orden === 'km-asc') r.sort((a, b) => (a.km || 0) - (b.km || 0))

      render(r)
    }

    async function cargar() {
      const { data, error } = await supabase
        .from('vehiculos')
        .select(
          'id, slug, marca, modelo, precio, precio_anterior, anio, km, fotos, publicado, estado, combustible, precio_oculto, reservado',
        )
        .order('created_at', { ascending: false })
      document.getElementById('cargando').hidden = true
      if (error) {
        document.getElementById('cargando').hidden = false
        document.getElementById('cargando').textContent =
          'Error: ' + error.message
        return
      }
      TODOS = data
      const marcasUnicas = [...new Set(data.map((v) => v.marca))].sort()
      document.getElementById('f-marca').innerHTML =
        '<option value="">Todas las marcas</option>' +
        marcasUnicas.map((m) => `<option>${m}</option>`).join('')
      aplicarFiltros()
    }

    async function onAccion(e) {
      const btn = e.currentTarget
      const id = btn.closest('.admin-row').dataset.id
      if (btn.dataset.accion === 'toggle') {
        const nuevo = btn.dataset.pub !== 'true'
        const { error } = await supabase
          .from('vehiculos')
          .update({ publicado: nuevo })
          .eq('id', id)
        if (error) return alert('Error: ' + error.message)
        cargar()
      }
      if (btn.dataset.accion === 'precio') {
        const nuevo = btn.dataset.oculto !== 'true'
        const { data, error } = await supabase
          .from('vehiculos')
          .update({ precio_oculto: nuevo })
          .eq('id', id)
          .select()
        if (error) return alert('Error: ' + error.message)
        if (!data?.length)
          return alert(
            'No se actualizó: falta la política UPDATE en vehiculos (RLS).',
          )
        cargar()
      }
      if (btn.dataset.accion === 'borrar') {
        if (
          !confirm(
            `¿Seguro que quieres BORRAR "${btn.dataset.nombre}"?\n\nEs permanente. Si solo se ha vendido, usa "Ocultar".`,
          )
        )
          return
        const { error } = await supabase.from('vehiculos').delete().eq('id', id)
        if (error) return alert('Error: ' + error.message)
        cargar()
      }
      if (btn.dataset.accion === 'avisar') {
        abrirAviso(TODOS.find((v) => String(v.id) === String(id)))
      }
    }

    // ───── AVISO A SUSCRIPTORES ─────
    const modal = document.getElementById('aviso-modal')
    let cocheAviso = null

    // Guardamos el contenido original de los botones para poder dejarlos como
    // estaban después de un envío
    const HTML_OPS = new Map(
      [...modal.querySelectorAll('.av-op')].map((b) => [
        b.dataset.tipo,
        b.innerHTML,
      ]),
    )
    function restaurarOps() {
      modal.querySelectorAll('.av-op').forEach((b) => {
        b.innerHTML = HTML_OPS.get(b.dataset.tipo)
        b.disabled = false
      })
    }

    function abrirAviso(v) {
      if (!v) return
      cocheAviso = v
      restaurarOps()
      document.getElementById('av-nombre').textContent =
        `${v.marca} ${v.modelo}`

      const nota = document.getElementById('av-nota')
      const opNuevo = modal.querySelector('[data-tipo="nuevo"]')
      const opBajada = document.getElementById('av-bajada')
      const info = document.getElementById('av-bajada-info')

      // El correo enseña el precio y enlaza a la ficha, así que hay casos en
      // los que no se puede mandar.
      let impedimento = ''
      if (!v.publicado) impedimento = 'Este coche está oculto: publícalo antes de avisar.'
      else if (v.reservado) impedimento = 'Está reservado, así que su precio no se muestra. Quita la reserva antes de avisar.'
      else if (v.precio_oculto) impedimento = 'Tiene el precio oculto y el correo lo mostraría. Muestra el precio antes de avisar.'

      nota.textContent = impedimento
      nota.hidden = !impedimento

      // "Bajada de precio" solo si de verdad ha bajado: el correo lo dice en el
      // asunto y tacha el precio anterior.
      const bajada = v.precio_anterior && v.precio_anterior > v.precio
      info.textContent = bajada
        ? `De ${fmt(v.precio_anterior)} € a ${fmt(v.precio)} €`
        : 'Necesita un precio anterior mayor que el actual (se pone al editar el coche)'

      opNuevo.disabled = !!impedimento
      opBajada.disabled = !!impedimento || !bajada
      modal.hidden = false
    }

    function cerrarAviso() {
      modal.hidden = true
      cocheAviso = null
      restaurarOps()
    }

    async function enviarAviso(tipo, boton) {
      if (!cocheAviso) return
      const ops = [...modal.querySelectorAll('.av-op')]
      ops.forEach((b) => (b.disabled = true))
      boton.textContent = 'Enviando…'
      try {
        const { data: sesion } = await supabase.auth.getSession()
        const res = await fetch('/api/notificar', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${sesion.session?.access_token ?? ''}`,
          },
          body: JSON.stringify({ vehiculoId: cocheAviso.id, tipo }),
        })
        const data = await res.json()
        if (!res.ok) throw new Error(data.error || 'Error ' + res.status)
        alert(data.aviso || `✅ Aviso enviado a ${data.enviados} suscriptor(es).`)
        cerrarAviso()
      } catch (err) {
        alert('Error al enviar: ' + err.message)
        // Volvemos a dejar el diálogo como estaba, con las mismas opciones
        if (cocheAviso) abrirAviso(cocheAviso)
      }
    }

    modal.querySelectorAll('.av-op').forEach((b) =>
      b.addEventListener('click', () => enviarAviso(b.dataset.tipo, b)),
    )
    document
      .getElementById('av-cancelar')
      .addEventListener('click', cerrarAviso)
    modal.addEventListener('click', (e) => {
      if (e.target === modal) cerrarAviso()
    })

    ;(async () => {
      const { data } = await supabase.auth.getSession()
      if (!data.session) {
        window.location.href = '/admin/login'
        return
      }
      document.getElementById('gate').hidden = true
      document.getElementById('panel').hidden = false
      ;[
        'buscar',
        'f-marca',
        'f-comb',
        'f-estado-coche',
        'f-pub',
        'f-orden',
      ].forEach((id) => {
        const el = document.getElementById(id)
        el.addEventListener(
          id === 'buscar' ? 'input' : 'change',
          aplicarFiltros,
        )
      })
      cargar()
    })()
  </script>
</Admin>
