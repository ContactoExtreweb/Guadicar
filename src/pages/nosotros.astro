---
import Base from '../layouts/Base.astro';

const valores = [
  { ico:'🤝', titulo:'Transparencia', texto:'Cada vehículo con su historial real y su estado verdadero. Sin sorpresas ni letra pequeña.' },
  { ico:'🛡️', titulo:'Seguridad', texto:'Todos nuestros coches pasan una revisión completa y salen con garantía. Compras con tranquilidad.' },
  { ico:'⭐', titulo:'Calidad', texto:'Seleccionamos cada vehículo con criterio. Solo ofrecemos coches en los que confiaríamos nosotros mismos.' },
  { ico:'❤️', titulo:'Cercanía', texto:'Te asesoramos sin presión, escuchando lo que necesitas. Aquí eres una persona, no una venta.' },
];

const stats = [
  { num:'35', sufijo:' años', label:'de experiencia en el sector' },
  { num:'+5.000', sufijo:'', label:'clientes satisfechos' },
  { num:'100%', sufijo:'', label:'vehículos revisados' },
  { num:'48h', sufijo:'', label:'para encontrar tu coche a la carta' },
];
---
<Base solidNav={true}
      title="Sobre nosotros · GuadiCar Multimarcas (Badajoz)"
      description="35 años ayudando a nuestros clientes a encontrar el coche perfecto en Villanueva de la Serena (Badajoz), con transparencia, seguridad y vehículos de calidad.">

<header class="cat-hero">
  <span class="tag" style="color:var(--red);">Quiénes somos</span>
  <h1>35 años sobre <em>ruedas</em></h1>
  <p>Ayudando a nuestros clientes a encontrar el coche perfecto, con transparencia, seguridad y vehículos de calidad.</p>
</header>

<!-- Historia -->
<section class="section section--white">
  <div class="nos-historia">
    <div class="nos-texto">
      <span class="tag">Nuestra historia</span>
      <h2>Más de tres décadas de confianza</h2>
      <p>En GuadiCar llevamos <strong>35 años en el sector del automóvil</strong>, ayudando a miles de familias y profesionales de Villanueva de la Serena y toda la comarca a encontrar el vehículo que mejor se adapta a sus necesidades.</p>
      <p>Lo que empezó como un pequeño negocio familiar se ha convertido en un concesionario multimarca de referencia, pero mantenemos intacto lo que siempre nos ha definido: el trato cercano, la honestidad en cada operación y el compromiso de ofrecer solo vehículos de calidad.</p>
      <p>Cada coche que entra en nuestras instalaciones pasa una revisión exhaustiva antes de salir a la venta. Porque para nosotros, tu seguridad y tu confianza valen más que una venta rápida.</p>
      <a href="/vehiculos" class="hero-btn-main" style="margin-top:1rem;">Ver nuestros vehículos</a>
    </div>
    <div class="nos-img">
      <video src="instalaciones_guadicar.mp4" autoplay loop playsinline controls></video>
    </div>
  </div>
</section>

<!-- Stats -->
<section class="section section--dark">
  <div class="nos-stats">
    {stats.map(s => (
      <div class="nos-stat">
        <div class="ns-num">{s.num}<span>{s.sufijo}</span></div>
        <div class="ns-label">{s.label}</div>
      </div>
    ))}
  </div>
</section>

<!-- Valores -->
<section class="section section--gray">
  <div class="s-header" style="text-align:center;max-width:580px;margin:0 auto 2.5rem;">
    <span class="tag">Lo que nos mueve</span>
    <h2 class="s-title">Nuestros valores</h2>
  </div>
  <div class="nos-valores">
    {valores.map(v => (
      <div class="nos-valor">
        <div class="nv-ico">{v.ico}</div>
        <h3>{v.titulo}</h3>
        <p>{v.texto}</p>
      </div>
    ))}
  </div>
</section>

<div class="cta-strip">
  <div><h2>Ven a conocernos</h2><p>Te esperamos en el Polígono Cagancha, 39 · Villanueva de la Serena</p></div>
  <a href="/contacto" class="btn-white">Cómo llegar</a>
</div>

<style>
  .nos-historia { display:grid; grid-template-columns:1.1fr 1fr; gap:3rem; align-items:center; max-width:1050px; margin:0 auto; }
  .nos-texto h2 { font-family:var(--font-h); font-size:1.9rem; font-weight:800; letter-spacing:-.5px; margin:.5rem 0 1.2rem; }
  .nos-texto p { color:var(--muted); line-height:1.8; margin-bottom:1rem; }
  .nos-texto strong { color:var(--text); }
  .nos-img { border-radius:var(--radius-lg); overflow:hidden; aspect-ratio:4/3; box-shadow:var(--shadow-lg); }
  .nos-img img { width:100%; height:100%; object-fit:cover; }
  .nos-stats { display:grid; grid-template-columns:repeat(4,1fr); gap:2rem; max-width:1000px; margin:0 auto; text-align:center; }
  .ns-num { font-family:var(--font-h); font-size:2.6rem; font-weight:800; color:#fff; line-height:1; }
  .ns-num span { color:var(--red); }
  .ns-label { color:rgba(255,255,255,.6); font-size:.85rem; margin-top:.5rem; }
  .nos-valores { display:grid; grid-template-columns:repeat(4,1fr); gap:1.5rem; max-width:1050px; margin:0 auto; }
  .nos-valor { background:#fff; border:1px solid var(--border); border-radius:14px; padding:1.8rem; text-align:center; }
  .nv-ico { font-size:2.2rem; margin-bottom:.5rem; }
  .nos-valor h3 { font-size:1.1rem; font-weight:800; margin:.3rem 0 .6rem; }
  .nos-valor p { color:var(--muted); font-size:.88rem; line-height:1.6; }
  @media (max-width:820px){
    .nos-historia { grid-template-columns:1fr; }
    .nos-stats, .nos-valores { grid-template-columns:1fr 1fr; }
  }
</style>

</Base>