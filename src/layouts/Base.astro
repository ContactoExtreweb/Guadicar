---
// Layout base: lo usan todas las páginas
import '../styles/styles.css';

const {
  title = 'GuadiCar Multimarcas — Vehículos de Ocasión y Km0 en Villanueva de la Serena',
  description = 'Concesionario multimarca en Villanueva de la Serena (Badajoz). Vehículos de ocasión, Km0 y nuevos con garantía y financiación. 35 años de experiencia.',
  image = '/logo.png',
  heroNav = false,          // true en páginas con hero oscuro (inicio)
  solidNav = true,         // true en páginas que siempre deben tener navbar sólido
} = Astro.props;

const SITE = Astro.site ?? new URL('https://pruebaguadicar.netlify.app');
const canonical = new URL(Astro.url.pathname, SITE).href;

// Datos estructurados para SEO local (Google)
const negocio = {
  '@context': 'https://schema.org',
  '@type': 'AutoDealer',
  name: 'GuadiCar Multimarcas',
  image: new URL('/logo.png', Astro.site).href,
  url: Astro.site,
  telephone: '+34696352820',
  email: 'ventas@guadicar.es',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Polígono Cagancha, 39',
    addressLocality: 'Villanueva de la Serena',
    addressRegion: 'Badajoz',
    postalCode: '06700',
    addressCountry: 'ES',
  },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday'], opens: '10:00', closes: '14:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday'], opens: '17:00', closes: '21:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '10:00', closes: '13:00' },
  ],
};
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <!-- Open Graph (cómo se ve al compartir en WhatsApp/redes) -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(image, Astro.site).href} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content="es_ES" />

  <!-- Datos estructurados -->
  <script type="application/ld+json" set:html={JSON.stringify(negocio)} />
</head>
<body>

<!-- ══ NAVBAR ══ -->
<nav class={`navbar${heroNav ? ' dark-mode' : ''}${solidNav ? ' scrolled solid' : ''}`}>
  <a href="/" class="nav-logo"><img src={heroNav ? '/logo.png' : '/logo_dark.png'} alt="GuadiCar Multimarcas" /></a>
  <ul class="nav-center">
    <li><a href="/">Inicio</a></li>
    <li><a href="/vehiculos">Vehículos</a></li>
    <li><a href="/carta">A la carta</a></li>
    <li><a href="/servicios">Servicios</a></li>
    <li><a href="/nosotros">Nosotros</a></li>
    <li><a href="/contacto">Contacto</a></li>
  </ul>
  <div class="nav-right">
    <div class="nav-phone">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      696 352 820
    </div>
    <a href="/contacto" class="btn-nav">Contactar</a>
  </div>
  <button class="nav-burger" aria-label="Menú"><span></span><span></span><span></span></button>
</nav>
<nav class="nav-mobile">
  <a href="/">Inicio</a>
  <a href="/vehiculos">Vehículos</a>
  <a href="/carta">A la carta</a>
  <a href="/servicios">Servicios</a>
  <a href="/nosotros">Nosotros</a>
  <a href="/contacto">Contacto</a>
</nav>

<!-- Contenido de cada página -->
<slot />

<!-- ══ FOOTER ══ -->
<footer class="footer">
  <div class="footer-top">
    <div>
      <div class="footer-logo"><img src="/logo.png" alt="GuadiCar Multimarcas" style="height:72px;" /></div>
      <p class="footer-tagline" style="max-width:340px;line-height:1.7;margin-top:1rem;">
        35 años en el sector ayudando a nuestros clientes a encontrar el coche perfecto, garantizando transparencia, seguridad y vehículos de calidad.
      </p>
    </div>
    <div class="footer-links">
      <div class="footer-col"><h4>Vehículos</h4><ul><li><a href="/vehiculos">Ocasión</a></li><li><a href="/vehiculos">Km 0</a></li><li><a href="/vehiculos">Eléctricos</a></li><li><a href="/vehiculos">SUVs</a></li></ul></div>
      <div class="footer-col"><h4>Empresa</h4><ul><li><a href="/servicios">Servicios</a></li><li><a href="/nosotros">Nosotros</a></li><li><a href="/contacto">Contacto</a></li></ul></div>
      <div class="footer-col">
        <h4>Contacto</h4>
        <ul>
          <li><a href="tel:+34696352820">696 352 820</a></li>
          <li><a href="mailto:ventas@guadicar.es">ventas@guadicar.es</a></li>
          <li>Polígono Cagancha, 39<br/>06700 Villanueva de la Serena (Badajoz)</li>
        </ul>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="footer-copy">© 2025 GuadiCar Multimarcas · Todos los derechos reservados</div>
    <div class="socials">
      <a href="https://www.instagram.com/guadicar_multimarcas" target="_blank" rel="noopener" class="social" aria-label="Instagram"><svg viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg></a>
    </div>
  </div>
</footer>

<!-- Comportamientos (navbar, menú móvil, animaciones) -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const navbar = document.querySelector('.navbar');
    const hero = document.getElementById('hero');
    const updateNav = () => {
      if (!navbar) return;
      if (navbar.classList.contains('solid')) return;
      navbar.classList.toggle('scrolled', window.scrollY > 20);
      if (hero) navbar.classList.toggle('dark-mode', hero.getBoundingClientRect().bottom > 0);
    };
    window.addEventListener('scroll', updateNav, { passive: true });
    updateNav();

    const page = window.location.pathname;
    document.querySelectorAll('.nav-center a, .nav-mobile a').forEach(a => {
      if (a.getAttribute('href') === page) a.classList.add('active');
    });

    const burger = document.querySelector('.nav-burger');
    const mobileNav = document.querySelector('.nav-mobile');
    if (burger && mobileNav) {
      burger.addEventListener('click', () => { burger.classList.toggle('open'); mobileNav.classList.toggle('open'); });
      mobileNav.querySelectorAll('a').forEach(a => a.addEventListener('click', () => { burger.classList.remove('open'); mobileNav.classList.remove('open'); }));
    }

    const ro = new IntersectionObserver(entries => {
      entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); ro.unobserve(e.target); } });
    }, { threshold: 0.1, rootMargin: '0px 0px -30px 0px' });
    document.querySelectorAll('.reveal').forEach(el => ro.observe(el));
  });
</script>
</body>
</html>