---
import '../styles/styles.css';
const { title = 'Panel · GuadiCar' } = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{title}</title>
</head>
<body style="background:var(--gray); min-height:100vh; margin:0;">
  <slot />
</body>
</html>