# Cabeceras de seguridad (Netlify). Sin CSP completa a propósito: con los
# scripts en línea, Supabase, Gemini y el mapa de Google es fácil romper algo.

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# El panel: nunca dentro de un iframe (clickjacking) y fuera de buscadores
/admin/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Robots-Tag: noindex, nofollow
